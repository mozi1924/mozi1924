---
interface Props {
  project: {
    name: string;
    slug?: string;
    pinned?: boolean;
    pinnedOrder?: number;
    description?: string;
    repoUrl: string;
    homepage?: string;
    stars: number;
    forks: number;
    language?: string;
    topics?: string[];
    license?: string;
    pushedAt?: string;
    archived?: boolean;
  };
  highlightPinned?: boolean;
}

const { project, highlightPinned = false } = Astro.props;
const projectSlug = project.slug || project.name.toLowerCase();

// Language dot colors
const languageColors: Record<string, string> = {
  Rust: "bg-[#dea584]",
  Python: "bg-[#3572A5]",
  TypeScript: "bg-[#3178c6]",
  JavaScript: "bg-[#f1e05a]",
  Java: "bg-[#b07219]",
  Astro: "bg-[#ff5a03]",
  HTML: "bg-[#e34c26]",
  C: "bg-[#555555]",
  "C++": "bg-[#f34b7d]",
};

const dotColor = languageColors[project.language || ""] || "bg-gray-400";
const formattedDate = project.pushedAt ? new Date(project.pushedAt).toLocaleDateString("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
}) : "";
---

<div
  class={`group relative flex flex-col justify-between rounded-2xl border backdrop-blur-sm transition-all duration-300 hover:-translate-y-1 p-6 ${
    project.pinned
      ? "border-[#3F89FC]/30 bg-[#161619]/80 hover:border-[#3F89FC]/70 hover:bg-[#1a1a22]/90 hover:shadow-[0_0_30px_rgba(63,137,252,0.18)]"
      : "border-white/10 bg-[#161619]/60 hover:border-[#3F89FC]/50 hover:bg-[#1a1a1f]/80 hover:shadow-[0_0_25px_rgba(63,137,252,0.12)]"
  }`}
  data-name={project.name.toLowerCase()}
  data-description={(project.description || "").toLowerCase()}
  data-language={(project.language || "other").toLowerCase()}
  data-topics={(project.topics || []).join(" ").toLowerCase()}
  data-stars={project.stars}
  data-updated={project.pushedAt || ""}
  data-pinned={project.pinned ? "true" : "false"}
  data-pinned-order={project.pinnedOrder ?? 999}
>
  <div>
    <!-- Top Row: Name and Badges -->
    <div class="flex items-start justify-between gap-3">
      <div class="flex flex-col gap-1 min-w-0">
        <a
          href={`/projects/${projectSlug}`}
          class="text-lg font-bold text-white transition-colors group-hover:text-[#3F89FC] hover:underline truncate"
        >
          {project.name}
        </a>
      </div>
      <div class="flex items-center gap-2 shrink-0">
        {project.pinned && (
          <span class="inline-flex items-center gap-1 rounded-md border border-[#3F89FC]/40 bg-[#3F89FC]/10 px-2 py-0.5 text-[11px] font-mono font-bold text-[#3F89FC] shadow-[0_0_10px_rgba(63,137,252,0.2)]">
            <span>📌</span>
            <span class="hidden sm:inline">Pinned</span>
          </span>
        )}
        <!-- Stars -->
        <div class="flex items-center gap-1 rounded-md border border-white/10 bg-white/[0.04] px-2 py-0.5 text-xs font-mono text-gray-300">
          <svg class="w-3.5 h-3.5 text-yellow-400 fill-current" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
          </svg>
          <span>{project.stars}</span>
        </div>
        <!-- Forks -->
        {project.forks > 0 && (
          <div class="flex items-center gap-1 rounded-md border border-white/10 bg-white/[0.04] px-2 py-0.5 text-xs font-mono text-gray-400">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 16 16">
              <path fill-rule="evenodd" d="M5 3.25a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm0 2.122a2.25 2.25 0 10-1.5 0v.878A2.25 2.25 0 005.75 8.5h1.5v2.128a2.251 2.251 0 101.5 0V8.5h1.5a2.25 2.25 0 002.25-2.25v-.878a2.25 2.25 0 10-1.5 0v.878a.75.75 0 01-.75.75h-4.5A.75.75 0 015 6.25v-.878zm3.75 7.378a.75.75 0 11-1.5 0 .75.75 0 011.5 0zm3-8.75a.75.75 0 100-1.5.75.75 0 000 1.5z"/>
            </svg>
            <span>{project.forks}</span>
          </div>
        )}
      </div>
    </div>

    <!-- Description -->
    <p class="mt-3 text-sm text-gray-400 line-clamp-2 leading-relaxed">
      {project.description || "No description provided."}
    </p>

    <!-- Topics -->
    {project.topics && project.topics.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {project.topics.slice(0, 4).map((topic) => (
          <span class="rounded-md border border-white/5 bg-white/[0.03] px-2 py-0.5 text-[11px] font-mono text-gray-400">
            #{topic}
          </span>
        ))}
        {project.topics.length > 4 && (
          <span class="text-[11px] font-mono text-gray-500 self-center">
            +{project.topics.length - 4}
          </span>
        )}
      </div>
    )}
  </div>

  <!-- Bottom Info & Actions -->
  <div class="mt-6 pt-4 border-t border-white/5 flex items-center justify-between text-xs text-gray-400">
    <div class="flex items-center gap-2">
      <span class={`inline-block w-2.5 h-2.5 rounded-full ${dotColor}`}></span>
      <span class="font-medium text-gray-300">{project.language || "Other"}</span>
      {project.archived && (
        <span class="ml-1 rounded px-1.5 py-0.5 text-[10px] uppercase font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">
          Archived
        </span>
      )}
    </div>

    <div class="flex items-center gap-3">
      <a
        href={`/projects/${projectSlug}`}
        class="text-gray-300 hover:text-[#3F89FC] font-medium transition-colors flex items-center gap-1"
      >
        <span>Docs</span>
        <span>→</span>
      </a>
      <a
        href={project.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-400 hover:text-white transition-colors"
        title="View on GitHub"
      >
        <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
      </a>
    </div>
  </div>
</div>
