---
import Icon from "@mozi/ui/Icon.astro";
import PillIndicator from "@mozi/ui/PillIndicator.astro";

const currentPath = Astro.url.pathname;

const navLinks = [
  { name: "Projects", href: "/", external: false },
  { name: "Main Site", href: "https://mozi1924.com", external: true },
  { name: "Blogs", href: "https://mozi1924.com/blogs", external: true },
  { name: "Articles", href: "https://mozi1924.com/article", external: true },
  { name: "About", href: "https://mozi1924.com/about", external: true },
];
---

<header
  id="main-header"
  transition:name="header"
  transition:persist="main-header"
  class="fixed top-0 w-full z-50 bg-[#111]/80 backdrop-blur-md border-b border-white/10 transition-[border-color] duration-500 h-16"
>
  <!-- Page Load Progress Bar (inside persisted header to survive navigation) -->
  <div
    id="page-load-progress-bar"
    class="absolute top-0 left-0 h-1 bg-white z-[100] transition-all duration-200 ease-out opacity-0 w-0 pointer-events-none shadow-[0_0_10px_rgba(255,255,255,0.5)]"
  >
  </div>

  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between relative z-30">
    <!-- Left: Logo & Hub Tag -->
    <div class="flex items-center gap-3">
      <a href="/" class="flex items-center gap-2 group/logo text-white">
        <div class="relative w-8 h-8 flex items-center justify-center">
          <img
            src="/favicon.svg"
            alt="Mozi Logo"
            class="w-8 h-8 group-hover/logo:scale-110 transition-transform duration-300"
          />
        </div>
        <span class="font-bold text-lg tracking-tight text-white group-hover/logo:text-[#3F89FC] transition-colors">
          Mozi1924
        </span>
      </a>
      <span class="hidden sm:inline-flex items-center px-2 py-0.5 text-[11px] font-mono rounded-full bg-white/5 border border-white/10 text-gray-400">
        Hub
      </span>
    </div>

    <!-- Center: Desktop Navigation Links -->
    <nav
      id="desktop-nav"
      class="hidden md:flex items-center gap-1 relative px-1 py-1 bg-white/[0.03] rounded-xl border border-white/5"
    >
      <PillIndicator id="nav-indicator" variant="subtle" />
      {
        navLinks.map((link) => {
          const isExternal = link.external;
          const isActive =
            !isExternal &&
            (link.href === "/"
              ? currentPath === "/" || currentPath.startsWith("/projects")
              : currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              target={isExternal ? "_blank" : undefined}
              rel={isExternal ? "noopener noreferrer" : undefined}
              data-nav-link
              data-href={link.href}
              class={`relative z-10 text-sm font-medium transition-colors px-4 py-2 rounded-lg group/link flex items-center gap-1.5 ${
                isActive ? "text-[#3F89FC]" : "text-gray-300 hover:text-white"
              }`}
            >
              <div class="absolute inset-0 bg-white/[0.04] rounded-lg opacity-0 group-hover/link:opacity-100 transition-opacity duration-200 -z-10 pointer-events-none" />
              <span>{link.name}</span>
              {isExternal && (
                <Icon name="external" className="w-3 h-3 text-gray-400 group-hover/link:text-white transition-colors" strokeWidth={2} />
              )}
            </a>
          );
        })
      }
    </nav>

    <!-- Right: Actions & Mobile Hamburger -->
    <div class="flex items-center gap-2">
      <a
        href="https://github.com/mozi1924"
        target="_blank"
        rel="noopener noreferrer"
        class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border border-white/10 bg-white/[0.03] text-xs font-medium text-gray-300 hover:text-white hover:bg-white/[0.07] hover:border-white/20 transition-all"
        title="GitHub Profile"
      >
        <Icon name="github" className="w-4 h-4" strokeWidth={2} />
        <span>GitHub</span>
      </a>

      <button
        id="mobile-menu-btn"
        class="md:hidden text-gray-400 hover:text-white hover:bg-white/5 rounded-lg transition-all focus:outline-none relative w-10 h-10 flex items-center justify-center"
        aria-label="Toggle menu"
      >
        <div class="relative w-6 h-6">
          <div
            id="menu-icon-open"
            class="absolute inset-0 flex items-center justify-center origin-center"
          >
            <Icon name="menu" className="w-6 h-6" />
          </div>
          <div
            id="menu-icon-close"
            class="absolute inset-0 flex items-center justify-center origin-center"
          >
            <Icon name="x" className="w-6 h-6" />
          </div>
        </div>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Drawer -->
  <div id="mobile-menu" class="md:hidden menu-transition">
    <nav
      id="mobile-menu-content"
      class="h-full flex flex-col items-center pt-24 pb-8 px-6 opacity-0 content-transition overflow-y-auto"
    >
      <div class="flex flex-col items-center space-y-4 w-full max-w-[280px]">
        {
          navLinks.map((link) => {
            const isExternal = link.external;
            const isActive =
              !isExternal &&
              (link.href === "/"
                ? currentPath === "/" || currentPath.startsWith("/projects")
                : currentPath.startsWith(link.href));
            return (
              <a
                href={link.href}
                target={isExternal ? "_blank" : undefined}
                rel={isExternal ? "noopener noreferrer" : undefined}
                class={`mobile-link relative z-10 text-2xl font-medium transition-colors px-6 py-3 rounded-lg group/mobile-link w-full text-center flex items-center justify-center gap-2 ${
                  isActive ? "text-[#3F89FC]" : "text-gray-300 hover:text-white"
                }`}
              >
                <div class="absolute inset-0 bg-white/[0.04] rounded-lg opacity-0 group-hover/mobile-link:opacity-100 transition-opacity duration-200 -z-10 pointer-events-none" />
                <span>{link.name}</span>
                {isExternal && (
                  <Icon name="external" className="w-4 h-4 text-gray-400" strokeWidth={2} />
                )}
              </a>
            );
          })
        }
        <div class="w-full pt-4 border-t border-white/10 flex justify-center">
          <a
            href="https://github.com/mozi1924"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl border border-white/10 bg-white/[0.05] text-sm font-medium text-white hover:bg-white/10 transition-colors"
          >
            <Icon name="github" className="w-4 h-4" strokeWidth={2} />
            <span>GitHub Profile</span>
          </a>
        </div>
      </div>
    </nav>
  </div>
</header>

<style>
  .menu-transition {
    position: fixed;
    inset: 0;
    height: 100dvh;
    background-color: #111;
    z-index: 20;
    clip-path: inset(0 0 100% 0);
    opacity: 0;
    transition:
      clip-path 0.5s cubic-bezier(0.32, 0.72, 0, 1),
      opacity 0.3s ease;
    will-change: clip-path, opacity;
    pointer-events: none;
  }

  .content-transition {
    transition: opacity 0.3s ease;
    transition-delay: 0.1s;
  }

  #mobile-menu.is-open {
    clip-path: inset(0 0 0 0);
    opacity: 1;
    pointer-events: auto;
  }

  #mobile-menu.is-open #mobile-menu-content {
    opacity: 1;
  }

  /* Icon Animations - Exactly matched with web */
  #menu-icon-open,
  #menu-icon-close {
    transition:
      transform 0.4s cubic-bezier(0.32, 0.72, 0, 1),
      opacity 0.4s ease;
  }

  #menu-icon-open {
    opacity: 1;
    transform: rotate(0) scale(1);
  }

  #menu-icon-close {
    opacity: 0;
    transform: rotate(-90deg) scale(0.5);
  }

  header.is-menu-open {
    border-color: transparent;
  }

  header.is-menu-open #menu-icon-open {
    opacity: 0;
    transform: rotate(90deg) scale(0.5);
  }

  header.is-menu-open #menu-icon-close {
    opacity: 1;
    transform: rotate(0deg) scale(1);
  }
</style>

<script>
  import { initProgressBar } from "@mozi/ui/scripts/progress-bar";
  import { scrollLock } from "@mozi/ui/utils/scrollLock";
  import { createPillIndicator } from "@mozi/ui/utils/pillIndicator";

  function setupHeader() {
    const btn = document.getElementById("mobile-menu-btn");
    const menu = document.getElementById("mobile-menu");
    const header = document.getElementById("main-header");
    let isOpen = false;

    if (btn && menu && header) {
      btn.onclick = () => {
        isOpen = !isOpen;
        if (isOpen) {
          menu.classList.add("is-open");
          header.classList.add("is-menu-open");
          scrollLock.lock();
        } else {
          menu.classList.remove("is-open");
          header.classList.remove("is-menu-open");
          scrollLock.unlock();
        }
      };

      menu.querySelectorAll("a").forEach((a) => {
        a.onclick = () => {
          isOpen = false;
          menu.classList.remove("is-open");
          header.classList.remove("is-menu-open");
          scrollLock.unlock();
        };
      });
    }

    // Desktop indicator & dynamic active link states across ViewTransitions
    const nav = document.getElementById("desktop-nav");
    const indicator = document.getElementById("nav-indicator");
    const links = document.querySelectorAll("[data-nav-link]");
    const currentPath = window.location.pathname;

    links.forEach((link) => {
      const href = link.getAttribute("data-href");
      const isExternal = href?.startsWith("http");
      const isActive =
        !isExternal &&
        (href === "/"
          ? currentPath === "/" || currentPath.startsWith("/projects")
          : currentPath.startsWith(href!));

      if (isActive) {
        link.classList.add("text-[#3F89FC]");
        link.classList.remove("text-gray-300", "hover:text-white");
      } else {
        link.classList.remove("text-[#3F89FC]");
        link.classList.add("text-gray-300", "hover:text-white");
      }
    });

    if (nav && indicator) {
      const activeLink = Array.from(links).find((l) => {
        const href = l.getAttribute("data-href");
        return href === "/"
          ? currentPath === "/" || currentPath.startsWith("/projects")
          : href && currentPath.startsWith(href);
      }) as HTMLElement | undefined;

      const isInitial = indicator.style.opacity === "0" || !indicator.style.left;
      const navPill = createPillIndicator({
        container: nav,
        indicator,
        initialActive: activeLink ?? null,
      });
      navPill.moveTo(activeLink ?? null, !isInitial);
    }
  }

  // Handle both initial load and client-side page transitions
  initProgressBar();
  setupHeader();
  document.addEventListener("astro:page-load", () => {
    initProgressBar();
    setupHeader();
    scrollLock.clear();
  });
</script>
