---
import { getCollection, render } from "astro:content";
import { marked } from "marked";
import Layout from "../../layouts/Layout.astro";
import Icon from "@mozi/ui/Icon.astro";
import PillIndicator from "@mozi/ui/PillIndicator.astro";
import { MOZI_IDENTITY } from "@mozi/ui/siteConfig";
import projectDetailsMap from "../../data/project-details.json";
import allProjectsSummary from "../../data/projects.json";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, "") },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const p = project.data;
const slug = project.id.replace(/\.md$/, "");

// Retrieve extra project details (TODO & Releases)
const details = (projectDetailsMap as Record<string, any>)[slug] || {};
const todo = details.todo;
const releases = details.releases || [];

const hasTodo = Boolean(todo && todo.content && todo.content.trim().length > 0);
const hasReleases = Boolean(releases && releases.length > 0);
const hasMultipleTabs = hasTodo || hasReleases;

// Pre-render TODO and Releases markdown via marked
const todoHtml = hasTodo ? marked.parse(todo.content) : "";
const parsedReleases = releases.map((r: any) => ({
  ...r,
  bodyHtml: r.body ? marked.parse(r.body) : "",
}));

// Formatted dates
const formattedDate = p.pushedAt
  ? new Date(p.pushedAt).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "";

function formatRelativeTime(dateStr: string) {
  if (!dateStr) return "";
  const date = new Date(dateStr);
  const diffDays = Math.floor((Date.now() - date.getTime()) / (1000 * 60 * 60 * 24));
  if (diffDays <= 0) return "Today";
  if (diffDays === 1) return "Yesterday";
  if (diffDays < 30) return `${diffDays} days ago`;
  if (diffDays < 365) return `${Math.floor(diffDays / 30)} months ago`;
  return `${Math.floor(diffDays / 365)} years ago`;
}
const relativeUpdate = formatRelativeTime(p.pushedAt);

// Topic Matching for "近似项目" (Related / Similar Projects)
const currentTopics = new Set(p.topics || []);
const relatedProjects = currentTopics.size > 0
  ? (allProjectsSummary as any[])
      .filter((other) => other.name !== p.name && other.topics && other.topics.length > 0)
      .map((other) => {
        const shared = other.topics.filter((t: string) => currentTopics.has(t));
        return { project: other, shared, score: shared.length };
      })
      .filter((res) => res.score > 0)
      .sort((a, b) => b.score - a.score || (b.project.stars || 0) - (a.project.stars || 0))
      .slice(0, 3)
  : [];

// Latest release information
const latestRelease = releases[0];

// Markdown snippet extraction for dynamic descriptions
function extractSnippetFromMarkdown(rawBody?: string): string {
  if (!rawBody) return "";
  const lines = rawBody.split("\n");
  for (const line of lines) {
    const trimmed = line.trim();
    if (
      !trimmed ||
      trimmed.startsWith("#") ||
      trimmed.startsWith("```") ||
      trimmed.startsWith("![") ||
      trimmed.startsWith("<img") ||
      trimmed.startsWith("[![") ||
      trimmed.startsWith("<div") ||
      trimmed.startsWith("|")
    ) {
      continue;
    }
    const clean = trimmed
      .replace(/\[([^\]]+)\]\([^)]+\)/g, "$1")
      .replace(/[*_`~]/g, "")
      .replace(/<[^>]+>/g, "")
      .trim();
    if (clean.length > 20 && !clean.toLowerCase().includes("no readme provided")) {
      return clean.length > 180 ? `${clean.slice(0, 177).trim()}...` : clean;
    }
  }
  return "";
}

const snippet = extractSnippetFromMarkdown(project.body);
const fallbackDescription = `${p.name} is an open-source ${p.language && p.language !== "Other" ? `${p.language} ` : ""}project by Mozi Arasaka${p.topics && p.topics.length ? ` exploring ${p.topics.slice(0, 3).join(", ")}` : ""}.`;
const effectiveDescription = (p.description && p.description.trim().length > 0)
  ? p.description.trim()
  : (snippet || fallbackDescription);

const summary = (allProjectsSummary as any[]).find(
  (s) => s.slug === slug || s.name.toLowerCase() === slug.toLowerCase() || s.name === p.name
);

// High-fidelity social preview: Curated project banner -> GitHub OpenGraph Card -> Default Avatar
const projectOgImage =
  summary?.image ||
  p.image ||
  `https://opengraph.githubassets.com/1/mozi1924/${p.name}`;

const canonicalHref = new URL(Astro.url.pathname, Astro.site || MOZI_IDENTITY.hubUrl).href;

const breadcrumbs = [
  {
    name: "Hub",
    item: new URL("/", Astro.site || MOZI_IDENTITY.hubUrl).href,
  },
  {
    name: p.name,
    item: canonicalHref,
  },
];

// Enhanced software schema.org structured data
const software = {
  name: p.name,
  description: effectiveDescription,
  codeRepository: p.repoUrl,
  programmingLanguage: p.language || "Other",
  license: p.license || undefined,
  version: latestRelease ? latestRelease.tagName : undefined,
  softwareVersion: latestRelease ? latestRelease.tagName : undefined,
  dateCreated: p.createdAt || undefined,
  dateModified: p.pushedAt || undefined,
  keywords: p.topics && p.topics.length > 0 ? p.topics : undefined,
  image: projectOgImage,
  applicationCategory: "DeveloperApplication",
};

// Helper for formatting file size
function formatBytes(bytes: number) {
  if (!bytes || bytes === 0) return "0 B";
  const k = 1024;
  const sizes = ["B", "KB", "MB", "GB"];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + " " + sizes[i];
}
---

<Layout
  title={`${p.name} - Open Source Project by Mozi Arasaka`}
  description={effectiveDescription}
  image={projectOgImage}
  type="article"
  schemaType="software"
  software={software}
  breadcrumbs={breadcrumbs}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-4 sm:pt-6 pb-20 md:pb-28 space-y-6 min-w-0 w-full overflow-x-clip [overflow-anchor:none]">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-gray-400 min-w-0 max-w-full overflow-hidden">
      <a href="/" class="hover:text-blue-400 transition-colors flex items-center gap-1.5 shrink-0">
        <Icon name="chevron-left" className="w-4 h-4" />
        <span>All Projects</span>
      </a>
      <span>/</span>
      <span class="text-gray-200 font-mono truncate max-w-[160px] sm:max-w-none">{p.name}</span>
    </nav>

    <!-- Project Showcase Header (De-boxed GitHub-style Repository Header) -->
    <header class="pb-6 border-b border-white/10 min-w-0 max-w-full">
      <div class="flex flex-col lg:flex-row lg:items-start justify-between gap-5 sm:gap-6">
        <div class="space-y-3.5 max-w-3xl min-w-0">
          <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
            <h1 class="text-2xl sm:text-3xl md:text-4xl font-extrabold tracking-tight text-white flex flex-wrap items-center gap-2.5 sm:gap-3 break-words hyphens-auto">
              <span>{p.name}</span>
              {latestRelease && (
                <span class="text-xs sm:text-sm font-mono font-bold px-2.5 py-0.5 rounded-full bg-blue-500/15 text-blue-400 border border-blue-500/30 shrink-0">
                  {latestRelease.tagName}
                </span>
              )}
            </h1>
            {p.archived ? (
              <span class="rounded-full px-2.5 py-0.5 text-xs font-mono font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20 shrink-0">
                Archived
              </span>
            ) : (
              <span class="rounded-full px-2.5 py-0.5 text-xs font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 shrink-0">
                Active
              </span>
            )}
          </div>

          <p class="text-sm sm:text-base text-gray-300 leading-relaxed break-words">
            {p.description || "Open-source project on GitHub."}
          </p>

          <!-- Metadata Chips -->
          <div class="flex flex-wrap items-center gap-2 text-xs font-mono pt-0.5">
            {p.pinned && (
              <div class="flex items-center gap-1.5 rounded-md border border-blue-500/30 bg-blue-500/10 px-2.5 py-1 text-blue-400 font-bold shrink-0">
                <span>Featured</span>
              </div>
            )}

            <!-- Language -->
            <div class="flex items-center gap-2 rounded-md border border-white/10 bg-white/[0.03] px-2.5 py-1 text-gray-200 shrink-0">
              <span class="w-2 h-2 rounded-full bg-blue-400"></span>
              <span>{p.language || "Other"}</span>
            </div>

            <!-- Stars -->
            <div class="flex items-center gap-1.5 rounded-md border border-white/10 bg-white/[0.03] px-2.5 py-1 text-yellow-400 font-bold shrink-0">
              <Icon name="star" className="w-3.5 h-3.5 fill-current" />
              <span>{p.stars} Stars</span>
            </div>

            <!-- Forks -->
            <div class="flex items-center gap-1.5 rounded-md border border-white/10 bg-white/[0.03] px-2.5 py-1 text-cyan-400 font-bold shrink-0">
              <Icon name="git-fork" className="w-3.5 h-3.5" strokeWidth={2} />
              <span>{p.forks} Forks</span>
            </div>

            <!-- License -->
            {p.license && (
              <div class="rounded-md border border-white/10 bg-white/[0.03] px-2.5 py-1 text-gray-300 shrink-0">
                License: <span class="text-white font-semibold">{p.license}</span>
              </div>
            )}

            <!-- Updated -->
            {formattedDate && (
              <div class="rounded-md border border-white/10 bg-white/[0.03] px-2.5 py-1 text-gray-400 shrink-0">
                Updated: {formattedDate}
              </div>
            )}
          </div>

          <!-- Topics -->
          {p.topics && p.topics.length > 0 && (
            <div class="flex flex-wrap gap-1.5 pt-0.5">
              {p.topics.map((topic: string) => (
                <span class="rounded-md border border-white/10 bg-white/[0.03] px-2 py-0.5 text-[11px] font-mono text-gray-400 hover:text-blue-300 transition-colors">
                  #{topic}
                </span>
              ))}
            </div>
          )}
        </div>

        <!-- Action Buttons (Responsive on Mobile: stacked vertically on mobile, side-by-side on tablet/desktop) -->
        <div class="flex flex-col sm:flex-row lg:flex-col items-stretch sm:items-center lg:items-stretch gap-2.5 w-full lg:w-auto shrink-0 pt-1 lg:pt-0">
          <a
            href={p.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600 px-4 py-2 text-xs sm:text-sm font-semibold text-white transition-all hover:bg-blue-500 shadow-md shadow-blue-600/20 min-h-[40px] w-full sm:w-auto lg:w-full"
          >
            <Icon name="star" className="w-4 h-4 fill-current text-yellow-300" />
            <span>Star on GitHub</span>
          </a>

          <a
            href={p.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-lg border border-white/10 bg-white/[0.04] px-4 py-2 text-xs sm:text-sm font-medium text-gray-200 hover:bg-white/[0.08] hover:text-white transition-all min-h-[40px] w-full sm:w-auto lg:w-full"
          >
            <Icon name="github" className="w-4 h-4" />
            <span>Source Code</span>
            <Icon name="external" className="w-3.5 h-3.5 text-gray-400" />
          </a>

          {p.homepage && p.homepage !== p.repoUrl && (
            <a
              href={p.homepage}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-lg border border-blue-500/20 bg-blue-500/10 px-4 py-2 text-xs sm:text-sm font-medium text-blue-400 hover:bg-blue-500/20 transition-all min-h-[40px] w-full sm:w-auto lg:w-full"
            >
              <span>Dedicated Page</span>
              <Icon name="arrow-right" className="w-3.5 h-3.5" />
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- Secondary Repository Navigation (Sticky GitHub-style Subnav across full width) -->
    {hasMultipleTabs && (
      <nav
        aria-label="Repository Navigation"
        class="sticky top-16 z-20 bg-[#111]/90 backdrop-blur-md border-b border-white/10 -mx-4 sm:-mx-6 px-4 sm:px-6 mb-2"
      >
        <div class="max-w-7xl mx-auto flex items-center justify-between">
          <div
            role="tablist"
            id="project-tablist"
            class="flex items-center gap-1 sm:gap-2 py-2 relative max-w-full overflow-x-auto no-scrollbar"
          >
            <!-- Smooth Sliding Highlight Indicator -->
            <PillIndicator id="tab-indicator" variant="solid-blue" />

            <button
              type="button"
              id="tab-btn-readme"
              onclick="window.switchTab('readme')"
              class="tab-btn active relative z-10 h-9 px-3.5 rounded-lg text-xs sm:text-sm font-semibold transition-colors duration-200 flex items-center gap-2 shrink-0 text-white cursor-pointer select-none"
              role="tab"
              aria-controls="panel-readme"
              aria-selected="true"
            >
              <Icon name="file-text" className="w-4 h-4 text-blue-200 shrink-0" />
              <span>README</span>
            </button>

            {hasTodo && (
              <button
                type="button"
                id="tab-btn-todo"
                onclick="window.switchTab('todo')"
                class="tab-btn relative z-10 h-9 px-3.5 rounded-lg text-xs sm:text-sm font-medium transition-colors duration-200 flex items-center gap-2 shrink-0 text-gray-400 hover:text-white cursor-pointer select-none"
                role="tab"
                aria-controls="panel-todo"
                aria-selected="false"
              >
                <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                </svg>
                <span>TODO & 路线图</span>
                {todo?.stats && (
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-amber-500/15 text-amber-400 border border-amber-500/25 shrink-0">
                    {todo.stats.percentage}%
                  </span>
                )}
              </button>
            )}

            {hasReleases && (
              <button
                type="button"
                id="tab-btn-releases"
                onclick="window.switchTab('releases')"
                class="tab-btn relative z-10 h-9 px-3.5 rounded-lg text-xs sm:text-sm font-medium transition-colors duration-200 flex items-center gap-2 shrink-0 text-gray-400 hover:text-white cursor-pointer select-none"
                role="tab"
                aria-controls="panel-releases"
                aria-selected="false"
              >
                <svg class="w-4 h-4 text-purple-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                <span>Releases</span>
                {latestRelease && (
                  <span class="px-1.5 py-0.5 rounded text-[10px] font-mono bg-purple-500/15 text-purple-300 border border-purple-500/25 shrink-0">
                    {latestRelease.tagName}
                  </span>
                )}
              </button>
            )}
          </div>
        </div>
      </nav>
    )}

    <!-- 2-Column Responsive Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8 items-start min-w-0 max-w-full">

      <!-- LEFT COLUMN: Primary Content with Semantic Tabs (8 Cols on lg, 9 Cols on xl) -->
      <main class="lg:col-span-8 xl:col-span-9 space-y-6 min-w-0 max-w-full">

        <!-- PANEL 1: README (Always available) -->
        <section
          id="panel-readme"
          role="tabpanel"
          aria-labelledby="tab-btn-readme"
          class="tab-panel border border-white/10 rounded-xl bg-[#111113]/50 overflow-hidden shadow-sm min-w-0 max-w-full"
        >
          <div class="px-4 py-2.5 border-b border-white/10 bg-white/[0.02] flex items-center justify-between text-xs font-mono text-gray-400">
            <div class="flex items-center gap-2 text-gray-300">
              <Icon name="file-text" className="w-4 h-4 text-blue-400" />
              <span class="font-bold">README.md</span>
            </div>
            <a
              href={`${p.repoUrl}/blob/${p.defaultBranch}/README.md`}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-blue-400 transition-colors flex items-center gap-1.5"
            >
              <span>View raw on GitHub</span>
              <Icon name="external" className="w-3.5 h-3.5 text-gray-500" />
            </a>
          </div>

          <div class="p-4 sm:p-6 md:p-8 min-w-0">
            <div class="github-readme prose prose-invert prose-blue max-w-none break-words min-w-0 prose-pre:bg-[#111113] prose-pre:border prose-pre:border-white/10 prose-pre:rounded-lg prose-headings:font-bold prose-headings:text-white prose-a:text-blue-400 hover:prose-a:underline">
              <Content />
            </div>
          </div>
        </section>

        <!-- PANEL 2: TODO.md (Conditionally Rendered) -->
        {hasTodo && (
          <section
            id="panel-todo"
            role="tabpanel"
            aria-labelledby="tab-btn-todo"
            class="tab-panel hidden border border-white/10 rounded-xl bg-[#111113]/50 overflow-hidden shadow-sm min-w-0 max-w-full"
          >
            <div class="px-4 py-2.5 border-b border-white/10 bg-white/[0.02] flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
              <div class="flex items-center gap-2 text-gray-300">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                </svg>
                <span class="font-bold">{todo.filename || "TODO.md"} · 路线图与待办事项</span>
              </div>
              {todo.stats && (
                <div class="flex items-center gap-2 text-xs">
                  <span class="text-emerald-400 font-semibold">{todo.stats.completed} 项已完成</span>
                  <span class="text-gray-600">/</span>
                  <span class="text-amber-400 font-semibold">{todo.stats.pending} 项待办</span>
                  <span class="text-gray-600">/</span>
                  <span class="text-gray-400">共 {todo.stats.total} 项</span>
                </div>
              )}
            </div>

            <div class="p-4 sm:p-6 md:p-8 min-w-0">
              <!-- Visual Progress Bar Card -->
              {todo.stats && todo.stats.total > 0 && (
                <div class="bg-white/[0.02] border border-white/10 rounded-xl p-4 sm:p-5 mb-8">
                  <div class="flex items-center justify-between text-xs font-mono mb-2.5">
                    <span class="text-gray-300 font-semibold">{p.name} 开发路线图完成度</span>
                    <span class="text-blue-400 font-bold">{todo.stats.percentage}% Complete</span>
                  </div>
                  <div class="w-full h-2.5 bg-white/10 rounded-full overflow-hidden p-0.5">
                    <div
                      class="h-full bg-gradient-to-r from-blue-500 via-cyan-400 to-emerald-400 rounded-full transition-all duration-500"
                      style={`width: ${Math.max(todo.stats.percentage, 4)}%`}
                    ></div>
                  </div>
                  <p class="mt-2.5 text-xs text-gray-400">
                    数据提取自最新 Git 主干仓库内 <code>{todo.filename}</code> 规范任务列表。
                  </p>
                </div>
              )}

              <!-- Rendered Markdown for TODO -->
              <div
                class="github-readme prose prose-invert prose-blue max-w-none break-words min-w-0 prose-pre:bg-[#111113] prose-pre:border prose-pre:border-white/10 prose-pre:rounded-lg prose-headings:font-bold prose-headings:text-white prose-a:text-blue-400 hover:prose-a:underline"
                set:html={todoHtml}
              />
            </div>
          </section>
        )}

        <!-- PANEL 3: Releases (Conditionally Rendered) -->
        {hasReleases && (
          <section
            id="panel-releases"
            role="tabpanel"
            aria-labelledby="tab-btn-releases"
            class="tab-panel hidden border border-white/10 rounded-xl bg-[#111113]/50 overflow-hidden shadow-sm min-w-0 max-w-full"
          >
            <div class="px-4 py-2.5 border-b border-white/10 bg-white/[0.02] flex items-center justify-between text-xs font-mono text-gray-400">
              <div class="flex items-center gap-2 text-gray-300">
                <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                <span class="font-bold">Releases · 版本发版与更新日志</span>
              </div>
              <span class="text-gray-500">GitHub Releases API</span>
            </div>

            <div class="p-4 sm:p-6 md:p-8 min-w-0">

            <!-- Releases Timeline -->
            <div class="space-y-8 relative before:absolute before:inset-0 before:left-3.5 before:w-0.5 before:bg-white/10">
              {parsedReleases.map((release: any, idx: number) => {
                const isLatest = idx === 0;
                const releaseDate = release.publishedAt
                  ? new Date(release.publishedAt).toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })
                  : "";

                return (
                  <div class="relative pl-7 sm:pl-8 space-y-3 min-w-0">
                    <div
                      class={`absolute left-1.5 top-2 w-4 h-4 rounded-full border-4 border-[#18181b] ${
                        isLatest ? "bg-blue-500" : "bg-white/30"
                      }`}
                    ></div>

                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <div class="flex items-center gap-2.5">
                        <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                          <a
                            href={release.htmlUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:text-blue-400 transition-colors"
                          >
                            {release.name || release.tagName}
                          </a>
                        </h3>
                        {isLatest && (
                          <span class="px-2 py-0.5 rounded text-xs font-mono bg-blue-500/20 text-blue-400 border border-blue-500/30">
                            Latest
                          </span>
                        )}
                        {release.prerelease && (
                          <span class="px-2 py-0.5 rounded text-xs font-mono bg-purple-500/20 text-purple-300 border border-purple-500/30">
                            Pre-release
                          </span>
                        )}
                      </div>
                      {releaseDate && (
                        <time class="text-xs font-mono text-gray-400" datetime={release.publishedAt}>
                          {releaseDate}
                        </time>
                      )}
                    </div>

                    <!-- Changelog body -->
                    {release.bodyHtml && (
                      <div
                        class="p-4 sm:p-5 rounded-lg border border-white/10 bg-white/[0.015] github-readme prose prose-invert prose-blue max-w-none text-xs sm:text-sm text-gray-300 min-w-0"
                        set:html={release.bodyHtml}
                      />
                    )}

                    <!-- Downloadable Assets -->
                    {release.assets && release.assets.length > 0 && (
                      <div class="pt-2 space-y-2">
                        <span class="text-xs font-mono text-gray-400 uppercase tracking-wider">
                          Release Assets ({release.assets.length}):
                        </span>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                          {release.assets.map((asset: any) => (
                            <a
                              href={asset.downloadUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="flex items-center justify-between p-3 rounded-lg border border-white/10 bg-white/[0.02] hover:bg-blue-600/10 hover:border-blue-500/30 transition-all group min-w-0"
                            >
                              <div class="flex items-center gap-2.5 truncate mr-2 min-w-0">
                                <svg
                                  class="w-4 h-4 text-blue-400 group-hover:scale-110 transition-transform shrink-0"
                                  fill="none"
                                  stroke="currentColor"
                                  viewBox="0 0 24 24"
                                >
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                                </svg>
                                <span class="text-xs font-mono text-gray-200 group-hover:text-white truncate">
                                  {asset.name}
                                </span>
                              </div>
                              <div class="flex items-center gap-1.5 text-[11px] font-mono text-gray-400 shrink-0">
                                <span>{formatBytes(asset.size)}</span>
                                {asset.downloadCount > 0 && (
                                  <span class="text-gray-500">· {asset.downloadCount} dl</span>
                                )}
                              </div>
                            </a>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
            </div>
          </section>
        )}

      </main>

      <!-- RIGHT COLUMN: Flat Cohesive Sidebar (4 Cols on lg, 3 Cols on xl) -->
      <aside class:list={[
        "lg:col-span-4 xl:col-span-3 space-y-6 lg:sticky min-w-0 max-w-full",
        hasMultipleTabs ? "lg:top-28" : "lg:top-20"
      ]}>

        <!-- Section 1: Quick Access & Install -->
        <div class="space-y-3 min-w-0">
          <div class="flex items-center justify-between">
            <h2 class="text-xs font-mono uppercase tracking-wider text-gray-400 font-bold flex items-center gap-2">
              <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>Quick Access & Install</span>
            </h2>
            {latestRelease && (
              <span class="text-[11px] font-mono text-blue-400 font-bold">
                {latestRelease.tagName}
              </span>
            )}
          </div>

          <!-- Quick Clone URL snippet -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between text-xs text-gray-400">
              <span>Git Clone URL</span>
              <button
                id="copy-btn"
                onclick={`window.copyToClipboard('${p.repoUrl}.git')`}
                class="text-blue-400 hover:text-blue-300 text-xs flex items-center gap-1 font-mono transition-colors cursor-pointer"
              >
                <Icon name="copy" className="w-3.5 h-3.5" />
                <span id="copy-btn-text">Copy</span>
              </button>
            </div>
            <div class="p-2.5 rounded-lg bg-[#161b22] border border-white/10 font-mono text-xs text-gray-300 break-all select-all">
              <code>git clone {p.repoUrl}.git</code>
            </div>
          </div>

          <!-- Navigate to Releases Tab Button (User choice: avoids wrong-platform auto-download) -->
          {hasReleases ? (
            <button
              type="button"
              onclick="window.switchTabAndScroll('releases')"
              class="w-full inline-flex items-center justify-center gap-2 rounded-lg bg-blue-600/15 border border-blue-500/30 px-3.5 py-2 text-xs font-semibold text-blue-400 hover:bg-blue-600/25 transition-all cursor-pointer group"
            >
              <svg class="w-4 h-4 text-purple-400 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
              <span>浏览 Releases 跨平台安装包 →</span>
            </button>
          ) : (
            <a
              href={p.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 rounded-lg border border-white/10 bg-white/[0.03] px-3.5 py-2 text-xs font-semibold text-gray-300 hover:bg-white/[0.06] hover:text-white transition-all"
            >
              <Icon name="github" className="w-4 h-4" />
              <span>Explore GitHub Repository</span>
            </a>
          )}
        </div>

        <!-- Section 2: Roadmap Pulse (Only rendered if TODO exists) -->
        {hasTodo && todo.stats && (
          <div class="border-t border-white/10 pt-5 space-y-3 min-w-0">
            <div class="flex items-center justify-between">
              <h2 class="text-xs font-mono uppercase tracking-wider text-gray-400 font-bold flex items-center gap-2">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <span>Roadmap Pulse (TODO)</span>
              </h2>
              <span class="text-xs font-mono text-blue-400 font-bold">
                {todo.stats.percentage}%
              </span>
            </div>

            <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden">
              <div
                class="h-full bg-blue-500 rounded-full transition-all duration-500"
                style={`width: ${Math.max(todo.stats.percentage, 4)}%`}
              ></div>
            </div>

            <div class="space-y-1.5 text-xs">
              <div class="flex items-center justify-between text-gray-400">
                <span>任务执行状态:</span>
                <span class="text-gray-200 font-mono">
                  {todo.stats.completed} 完成 / {todo.stats.pending} 待办
                </span>
              </div>
              {relativeUpdate && (
                <div class="flex items-center justify-between text-gray-400">
                  <span>最后追踪变动:</span>
                  <span class="text-emerald-400 font-mono">{relativeUpdate}</span>
                </div>
              )}
            </div>

            <button
              type="button"
              onclick="window.switchTabAndScroll('todo')"
              class="w-full text-center text-xs text-amber-400 hover:text-amber-300 font-medium py-1.5 rounded-lg border border-amber-500/20 bg-amber-500/5 hover:bg-amber-500/10 transition-colors cursor-pointer"
            >
              查看完整路线图清单 →
            </button>
          </div>
        )}

        <!-- Section 3: 近似项目 (Related Projects via GitHub Topics) -->
        {relatedProjects.length > 0 && (
          <div class="border-t border-white/10 pt-5 space-y-3 min-w-0">
            <h2 class="text-xs font-mono uppercase tracking-wider text-gray-400 font-bold flex items-center gap-2">
              <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
              <span>近似项目 (Related Projects)</span>
            </h2>

            <div class="space-y-2 pt-0.5">
              {relatedProjects.map((item: any) => (
                <a
                  href={`/projects/${item.project.slug || item.project.name.toLowerCase()}`}
                  class="block p-2.5 rounded-lg border border-white/5 bg-white/[0.015] hover:bg-white/[0.04] hover:border-white/10 transition-all group min-w-0"
                >
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-mono font-bold text-gray-200 group-hover:text-blue-400 transition-colors truncate">
                      {item.project.name}
                    </span>
                    <span class="flex items-center gap-1 text-[11px] font-mono text-yellow-400/80 shrink-0">
                      <Icon name="star" className="w-3 h-3 fill-current" />
                      <span>{item.project.stars}</span>
                    </span>
                  </div>

                  {item.project.description && (
                    <p class="text-[11px] text-gray-400 line-clamp-1 mt-1 font-sans">
                      {item.project.description}
                    </p>
                  )}

                  {item.shared && item.shared.length > 0 && (
                    <div class="flex flex-wrap gap-1 mt-2">
                      {item.shared.map((tag: string) => (
                        <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-400/90 border border-blue-500/20">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Section 4: Repository Details (Metadata) -->
        <div class="border-t border-white/10 pt-5 space-y-3 text-xs font-mono text-gray-400 min-w-0">
          <h2 class="uppercase tracking-wider font-bold text-gray-300">
            Repository Details
          </h2>
          <div class="divide-y divide-white/5 space-y-2">
            <div class="flex justify-between pt-2">
              <span>Default Branch</span>
              <span class="text-white font-medium">{p.defaultBranch}</span>
            </div>
            <div class="flex justify-between pt-2">
              <span>Primary Language</span>
              <span class="text-white font-medium">{p.language || "Other"}</span>
            </div>
            {p.license && (
              <div class="flex justify-between pt-2">
                <span>License</span>
                <span class="text-white font-medium">{p.license}</span>
              </div>
            )}
            {relativeUpdate && (
              <div class="flex justify-between pt-2">
                <span>Last Updated</span>
                <span class="text-white font-medium">{relativeUpdate}</span>
              </div>
            )}
          </div>
        </div>

      </aside>

    </div>
  </div>

  <script>
    import { createPillIndicator, type PillIndicatorInstance } from "@mozi/ui/utils/pillIndicator";

    let tabPill: PillIndicatorInstance | null = null;

    function getOrCreatePill() {
      const container = document.getElementById("project-tablist");
      const indicator = document.getElementById("tab-indicator");
      if (!container || !indicator) return null;

      if (!tabPill) {
        tabPill = createPillIndicator({
          container,
          indicator,
          scrollIntoView: true,
        });
      }
      return tabPill;
    }

    // Tab switching logic compliant with accessible ARIA standards & URL fragments
    (window as any).switchTab = function (tabId: string, updateUrl = true) {
      const pill = getOrCreatePill();
      const tabs = ["readme", "todo", "releases"];
      tabs.forEach((t) => {
        const btn = document.getElementById(`tab-btn-${t}`);
        const panel = document.getElementById(`panel-${t}`);
        if (!panel) return;

        if (t === tabId) {
          if (btn) {
            btn.classList.add("text-white", "font-semibold");
            btn.classList.remove("text-gray-400", "font-medium");
            btn.setAttribute("aria-selected", "true");
            pill?.moveTo(btn, true);
          }
          panel.classList.remove("hidden");
        } else {
          if (btn) {
            btn.classList.remove("text-white", "font-semibold");
            btn.classList.add("text-gray-400", "font-medium");
            btn.setAttribute("aria-selected", "false");
          }
          panel.classList.add("hidden");
        }
      });

      // Update URL hash without forcing full page reload
      if (updateUrl && window.history && window.history.replaceState) {
        window.history.replaceState(null, "", "#" + tabId);
      }
    };

    // Switch tab and smooth scroll to target panel (with fixed header + subnav offset compensation)
    (window as any).switchTabAndScroll = function (tabId: string) {
      (window as any).switchTab(tabId, true);
      const panel = document.getElementById("panel-" + tabId);
      if (panel) {
        // Offset for 64px fixed header + 52px sticky subnav + 14px breathing room
        const headerOffset = 130;
        const elementPosition = panel.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
        window.scrollTo({
          top: offsetPosition,
          behavior: "smooth",
        });
      }
    };

    // Deep-linking support and indicator initialization on mount / navigation
    function initTabs() {
      const hash = window.location.hash.replace("#", "");
      const activeTab = ["readme", "todo", "releases"].includes(hash) ? hash : "readme";
      const targetBtn = document.getElementById(`tab-btn-${activeTab}`) || document.getElementById("tab-btn-readme");

      // Don't inject #readme into URL if the user visited with a clean URL path
      (window as any).switchTab(activeTab, Boolean(hash));

      if (targetBtn) {
        const pill = getOrCreatePill();
        pill?.moveTo(targetBtn, false);
      }
    }

    // Run on script execution
    initTabs();

    // Astro View Transitions: fires every time a page is entered via client-side routing
    document.addEventListener("astro:page-load", () => {
      tabPill?.destroy();
      tabPill = null;
      initTabs();
    });

    // Browser back/forward navigation support
    window.addEventListener("hashchange", () => {
      const hash = window.location.hash.replace("#", "");
      const activeTab = ["readme", "todo", "releases"].includes(hash) ? hash : "readme";
      (window as any).switchTab(activeTab, false);
    });

    // Copy to clipboard helper
    (window as any).copyToClipboard = function (text: string) {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(text);
        const label = document.getElementById("copy-btn-text");
        if (label) {
          const original = label.innerText;
          label.innerText = "Copied!";
          setTimeout(() => {
            label.innerText = original;
          }, 2000);
        }
      }
    };
  </script>
</Layout>
