---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Icon from "@mozi/ui/Icon.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, "") },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const p = project.data;

const formattedDate = p.pushedAt
  ? new Date(p.pushedAt).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "";

const schemaData = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  "name": p.name,
  "description": p.description || `${p.name} open-source project by Mozi Arasaka`,
  "codeRepository": p.repoUrl,
  "programmingLanguage": p.language || "Other",
  "license": p.license ? `https://spdx.org/licenses/${p.license}` : undefined,
  "author": {
    "@type": "Person",
    "name": "Mozi Arasaka",
    "alternateName": "mozi1924",
    "url": "https://mozi1924.com",
  },
};
---

<Layout
  title={`${p.name} - Open Source Project by Mozi Arasaka`}
  description={p.description || `Documentation and README for ${p.name} by Mozi Arasaka.`}
  type="article"
  schemaData={schemaData}
>
  <div class="max-w-5xl mx-auto px-6 py-12">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-sm text-gray-400 mb-8">
      <a href="/" class="hover:text-[#3F89FC] transition-colors flex items-center gap-1.5">
        <Icon name="chevron-left" className="w-4 h-4" />
        <span>All Projects</span>
      </a>
      <span>/</span>
      <span class="text-gray-200 font-mono text-xs">{p.name}</span>
    </nav>

    <!-- Project Showcase Header Card -->
    <header class="rounded-3xl border border-white/10 bg-[#161616] p-8 sm:p-10 backdrop-blur-md shadow-2xl relative overflow-hidden">
      <!-- Glow Accent -->
      <div class="pointer-events-none absolute -right-20 -top-20 w-80 h-80 bg-[#3F89FC]/15 blur-[90px] rounded-full"></div>

      <div class="relative z-10 flex flex-col gap-6">
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold tracking-tight text-white">
              {p.name}
            </h1>
            {p.archived && (
              <span class="rounded-full px-3 py-1 text-xs font-mono font-bold bg-amber-500/10 text-amber-400 border border-amber-500/30">
                Archived
              </span>
            )}
          </div>
          <p class="mt-4 text-base sm:text-lg text-gray-300 leading-relaxed max-w-3xl">
            {p.description || "Open-source project on GitHub."}
          </p>
        </div>

        <!-- Metadata Chips -->
        <div class="flex flex-wrap items-center gap-3 text-xs font-mono">
          {p.pinned && (
            <div class="flex items-center gap-1.5 rounded-xl border border-[#3F89FC]/40 bg-[#3F89FC]/15 px-3.5 py-1.5 text-[#3F89FC] font-bold shadow-[0_0_15px_rgba(63,137,252,0.25)]">
              <span>📌</span>
              <span>Pinned on GitHub</span>
            </div>
          )}

          <!-- Language -->
          <div class="flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.03] px-3.5 py-1.5 text-gray-200">
            <span class="w-2.5 h-2.5 rounded-full bg-[#3F89FC]"></span>
            <span>{p.language || "Other"}</span>
          </div>

          <!-- Stars -->
          <div class="flex items-center gap-1.5 rounded-xl border border-white/10 bg-white/[0.03] px-3.5 py-1.5 text-yellow-400 font-bold">
            <Icon name="star" className="w-3.5 h-3.5 fill-current" />
            <span>{p.stars} Stars</span>
          </div>

          <!-- Forks -->
          <div class="flex items-center gap-1.5 rounded-xl border border-white/10 bg-white/[0.03] px-3.5 py-1.5 text-cyan-400 font-bold">
            <Icon name="git-fork" className="w-3.5 h-3.5" strokeWidth={2} />
            <span>{p.forks} Forks</span>
          </div>

          <!-- License -->
          {p.license && (
            <div class="rounded-xl border border-white/10 bg-white/[0.03] px-3.5 py-1.5 text-gray-300">
              License: <span class="text-white font-semibold">{p.license}</span>
            </div>
          )}

          <!-- Updated -->
          {formattedDate && (
            <div class="rounded-xl border border-white/10 bg-white/[0.03] px-3.5 py-1.5 text-gray-400">
              Updated: {formattedDate}
            </div>
          )}
        </div>

        <!-- Topics -->
        {p.topics && p.topics.length > 0 && (
          <div class="flex flex-wrap gap-2 pt-2">
            {p.topics.map((topic) => (
              <span class="rounded-lg border border-white/5 bg-white/[0.04] px-2.5 py-1 text-xs font-mono text-gray-400">
                #{topic}
              </span>
            ))}
          </div>
        )}

        <!-- High-contrast Action Buttons (Lead Generation & Traffic Funnel) -->
        <div class="flex flex-wrap items-center gap-4 pt-4 border-t border-white/10">
          <a
            href={p.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 rounded-xl bg-[#3F89FC] px-5 py-3 text-sm font-bold text-white shadow-[0_0_20px_rgba(63,137,252,0.35)] transition-all hover:bg-[#3277e0] hover:shadow-[0_0_28px_rgba(63,137,252,0.5)] cursor-pointer"
          >
            <Icon name="star" className="w-4 h-4 fill-current" />
            <span>Star Repository on GitHub</span>
          </a>

          <a
            href={p.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-5 py-3 text-sm font-medium text-gray-200 hover:bg-white/[0.08] hover:text-white transition-all"
          >
            <span>View Source Code</span>
            <Icon name="external" className="w-4 h-4 text-gray-400" />
          </a>

          {p.homepage && p.homepage !== p.repoUrl && (
            <a
              href={p.homepage}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 rounded-xl border border-[#3F89FC]/30 bg-[#3F89FC]/10 px-5 py-3 text-sm font-medium text-[#3F89FC] hover:bg-[#3F89FC]/20 transition-all"
            >
              <span>Live Demo / Homepage</span>
              <Icon name="external" className="w-4 h-4" />
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- README Content Section -->
    <article class="mt-12 rounded-3xl border border-white/10 bg-[#161616] p-8 sm:p-12 backdrop-blur-sm">
      <div class="mb-6 pb-4 border-b border-white/10 flex items-center justify-between text-xs font-mono text-gray-400">
        <div class="flex items-center gap-2">
          <Icon name="file-text" className="w-4 h-4 text-gray-400" />
          <span>README.md</span>
        </div>
        <a
          href={`${p.repoUrl}/blob/${p.defaultBranch}/README.md`}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[#3F89FC] transition-colors"
        >
          Edit on GitHub ↗
        </a>
      </div>

      <div class="prose prose-invert prose-blue max-w-none prose-pre:bg-[#121214] prose-pre:border prose-pre:border-white/10 prose-headings:font-bold prose-headings:text-white prose-a:text-[#3F89FC] hover:prose-a:underline prose-img:rounded-xl prose-img:border prose-img:border-white/10">
        <Content />
      </div>
    </article>
  </div>
</Layout>
