---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import Icon from "@mozi/ui/Icon.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, "") },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const p = project.data;

const formattedDate = p.pushedAt
  ? new Date(p.pushedAt).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "";

const software = {
  name: p.name,
  description: p.description || `${p.name} open-source project by Mozi Arasaka`,
  codeRepository: p.repoUrl,
  programmingLanguage: p.language || "Other",
  license: p.license,
};
---

<Layout
  title={`${p.name} - Open Source Project by Mozi Arasaka`}
  description={p.description || `Documentation and README for ${p.name} by Mozi Arasaka.`}
  type="article"
  schemaType="software"
  software={software}
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-8 sm:pt-12 pb-20 md:pb-28">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-gray-400 mb-6 sm:mb-8">
      <a href="/" class="hover:text-blue-400 transition-colors flex items-center gap-1.5">
        <Icon name="chevron-left" className="w-4 h-4" />
        <span>All Projects</span>
      </a>
      <span>/</span>
      <span class="text-gray-200 font-mono truncate max-w-[200px] sm:max-w-none">{p.name}</span>
    </nav>

    <!-- Project Showcase Header Card -->
    <header class="rounded-2xl md:rounded-3xl border border-white/5 bg-[#1a1a1a] p-5 sm:p-8 md:p-10 shadow-xl relative overflow-hidden">
      <div class="relative z-10 flex flex-col gap-6">
        <div>
          <div class="flex flex-wrap items-center gap-3">
            <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-bold tracking-tight text-white">
              {p.name}
            </h1>
            {p.archived && (
              <span class="rounded-full px-2.5 py-0.5 text-xs font-mono font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20">
                Archived
              </span>
            )}
          </div>
          <p class="mt-3 text-sm sm:text-base md:text-lg text-gray-300 leading-relaxed max-w-3xl">
            {p.description || "Open-source project on GitHub."}
          </p>
        </div>

        <!-- Metadata Chips -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-xs font-mono">
          {p.pinned && (
            <div class="flex items-center gap-1.5 rounded-lg border border-blue-500/30 bg-blue-500/10 px-3 py-1 text-blue-400 font-bold">
              <span>Featured</span>
            </div>
          )}

          <!-- Language -->
          <div class="flex items-center gap-2 rounded-lg border border-white/5 bg-white/[0.03] px-3 py-1 text-gray-200">
            <span class="w-2 h-2 rounded-full bg-blue-400"></span>
            <span>{p.language || "Other"}</span>
          </div>

          <!-- Stars -->
          <div class="flex items-center gap-1.5 rounded-lg border border-white/5 bg-white/[0.03] px-3 py-1 text-yellow-400 font-bold">
            <Icon name="star" className="w-3.5 h-3.5 fill-current" />
            <span>{p.stars} Stars</span>
          </div>

          <!-- Forks -->
          <div class="flex items-center gap-1.5 rounded-lg border border-white/5 bg-white/[0.03] px-3 py-1 text-cyan-400 font-bold">
            <Icon name="git-fork" className="w-3.5 h-3.5" strokeWidth={2} />
            <span>{p.forks} Forks</span>
          </div>

          <!-- License -->
          {p.license && (
            <div class="rounded-lg border border-white/5 bg-white/[0.03] px-3 py-1 text-gray-300">
              License: <span class="text-white font-semibold">{p.license}</span>
            </div>
          )}

          <!-- Updated -->
          {formattedDate && (
            <div class="rounded-lg border border-white/5 bg-white/[0.03] px-3 py-1 text-gray-400">
              Updated: {formattedDate}
            </div>
          )}
        </div>

        <!-- Topics -->
        {p.topics && p.topics.length > 0 && (
          <div class="flex flex-wrap gap-1.5 pt-1">
            {p.topics.map((topic) => (
              <span class="rounded-md border border-white/5 bg-white/[0.03] px-2.5 py-0.5 text-xs font-mono text-gray-400">
                #{topic}
              </span>
            ))}
          </div>
        )}

        <!-- Action Buttons (Responsive on Mobile) -->
        <div class="flex flex-col sm:flex-row flex-wrap items-stretch sm:items-center gap-3 pt-4 border-t border-white/5">
          <a
            href={p.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition-all hover:bg-blue-500 min-h-[44px]"
          >
            <Icon name="star" className="w-4 h-4 fill-current text-yellow-300" />
            <span>Star on GitHub</span>
          </a>

          <a
            href={p.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-5 py-2.5 text-sm font-medium text-gray-200 hover:bg-white/[0.08] hover:text-white transition-all min-h-[44px]"
          >
            <Icon name="github" className="w-4 h-4" />
            <span>View Source Code</span>
            <Icon name="external" className="w-3.5 h-3.5 text-gray-400" />
          </a>

          {p.homepage && p.homepage !== p.repoUrl && (
            <a
              href={p.homepage}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-blue-500/20 bg-blue-500/10 px-5 py-2.5 text-sm font-medium text-blue-400 hover:bg-blue-500/20 transition-all min-h-[44px]"
            >
              <span>Dedicated Article / Page</span>
              <Icon name="arrow-right" className="w-3.5 h-3.5" />
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- README Content Section -->
    <article class="mt-8 sm:mt-12 rounded-2xl md:rounded-3xl border border-white/5 bg-[#1a1a1a] p-5 sm:p-8 md:p-12 shadow-sm">
      <div class="mb-6 pb-4 border-b border-white/5 flex items-center justify-between text-xs font-mono text-gray-400">
        <div class="flex items-center gap-2">
          <Icon name="file-text" className="w-4 h-4 text-gray-400" />
          <span>README.md</span>
        </div>
        <a
          href={`${p.repoUrl}/blob/${p.defaultBranch}/README.md`}
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-blue-400 transition-colors flex items-center gap-1"
        >
          <span>View on GitHub</span>
          <Icon name="external" className="w-3 h-3" />
        </a>
      </div>

      <div class="prose prose-invert prose-blue max-w-none break-words overflow-x-auto prose-pre:bg-[#141416] prose-pre:border prose-pre:border-white/5 prose-pre:rounded-xl prose-pre:overflow-x-auto prose-headings:font-bold prose-headings:text-white prose-a:text-blue-400 hover:prose-a:underline prose-img:rounded-xl prose-img:border prose-img:border-white/5 prose-table:overflow-x-auto">
        <Content />
      </div>
    </article>
  </div>
</Layout>
