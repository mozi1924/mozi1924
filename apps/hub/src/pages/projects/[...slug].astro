---
import { getCollection, render } from "astro:content";
import { marked } from "marked";
import Layout from "../../layouts/Layout.astro";
import Icon from "@mozi/ui/Icon.astro";
import projectDetailsMap from "../../data/project-details.json";
import allProjectsSummary from "../../data/projects.json";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id.replace(/\.md$/, "") },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const p = project.data;
const slug = project.id.replace(/\.md$/, "");

// Retrieve extra project details (TODO & Releases)
const details = (projectDetailsMap as Record<string, any>)[slug] || {};
const todo = details.todo;
const releases = details.releases || [];

const hasTodo = Boolean(todo && todo.content && todo.content.trim().length > 0);
const hasReleases = Boolean(releases && releases.length > 0);
const hasMultipleTabs = hasTodo || hasReleases;

// Pre-render TODO and Releases markdown via marked
const todoHtml = hasTodo ? marked.parse(todo.content) : "";
const parsedReleases = releases.map((r: any) => ({
  ...r,
  bodyHtml: r.body ? marked.parse(r.body) : "",
}));

// Formatted dates
const formattedDate = p.pushedAt
  ? new Date(p.pushedAt).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "";

function formatRelativeTime(dateStr: string) {
  if (!dateStr) return "";
  const date = new Date(dateStr);
  const diffDays = Math.floor((Date.now() - date.getTime()) / (1000 * 60 * 60 * 24));
  if (diffDays <= 0) return "Today";
  if (diffDays === 1) return "Yesterday";
  if (diffDays < 30) return `${diffDays} days ago`;
  if (diffDays < 365) return `${Math.floor(diffDays / 30)} months ago`;
  return `${Math.floor(diffDays / 365)} years ago`;
}
const relativeUpdate = formatRelativeTime(p.pushedAt);

// Topic Matching for "近似项目" (Related / Similar Projects)
const currentTopics = new Set(p.topics || []);
const relatedProjects = currentTopics.size > 0
  ? (allProjectsSummary as any[])
      .filter((other) => other.name !== p.name && other.topics && other.topics.length > 0)
      .map((other) => {
        const shared = other.topics.filter((t: string) => currentTopics.has(t));
        return { project: other, shared, score: shared.length };
      })
      .filter((res) => res.score > 0)
      .sort((a, b) => b.score - a.score || (b.project.stars || 0) - (a.project.stars || 0))
      .slice(0, 3)
  : [];

// Latest release information
const latestRelease = releases[0];

// Software schema.org structured data
const software = {
  name: p.name,
  description: p.description || `${p.name} open-source project by Mozi Arasaka`,
  codeRepository: p.repoUrl,
  programmingLanguage: p.language || "Other",
  license: p.license || undefined,
  softwareVersion: latestRelease ? latestRelease.tagName : undefined,
  dateModified: p.pushedAt || undefined,
};

// Helper for formatting file size
function formatBytes(bytes: number) {
  if (!bytes || bytes === 0) return "0 B";
  const k = 1024;
  const sizes = ["B", "KB", "MB", "GB"];
  const i = Math.floor(Math.log(bytes) / Math.log(k));
  return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + " " + sizes[i];
}
---

<Layout
  title={`${p.name} - Open Source Project by Mozi Arasaka`}
  description={p.description || `Documentation and README for ${p.name} by Mozi Arasaka.`}
  type="article"
  schemaType="software"
  software={software}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 pt-4 sm:pt-8 pb-20 md:pb-28 space-y-6 sm:space-y-8 min-w-0 w-full overflow-x-clip">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs sm:text-sm text-gray-400 min-w-0 max-w-full overflow-hidden">
      <a href="/" class="hover:text-blue-400 transition-colors flex items-center gap-1.5 shrink-0">
        <Icon name="chevron-left" className="w-4 h-4" />
        <span>All Projects</span>
      </a>
      <span>/</span>
      <span class="text-gray-200 font-mono truncate max-w-[160px] sm:max-w-none">{p.name}</span>
    </nav>

    <!-- Project Showcase Header Card -->
    <header class="rounded-2xl md:rounded-3xl border border-white/5 bg-[#18181b] p-5 sm:p-8 md:p-10 shadow-xl relative overflow-hidden min-w-0 max-w-full">
      <!-- Glow gradient background -->
      <div class="absolute -top-24 -right-24 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 flex flex-col lg:flex-row lg:items-start justify-between gap-6">
        <div class="space-y-4 max-w-3xl min-w-0">
          <div class="flex flex-wrap items-center gap-2.5 sm:gap-3">
            <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold tracking-tight text-white flex flex-wrap items-center gap-2.5 sm:gap-3 break-words hyphens-auto">
              <span>{p.name}</span>
              {latestRelease && (
                <span class="text-xs sm:text-sm font-mono font-bold px-2.5 py-0.5 rounded-full bg-blue-500/15 text-blue-400 border border-blue-500/30 shrink-0">
                  {latestRelease.tagName}
                </span>
              )}
            </h1>
            {p.archived ? (
              <span class="rounded-full px-2.5 py-0.5 text-xs font-mono font-bold bg-amber-500/10 text-amber-400 border border-amber-500/20 shrink-0">
                Archived
              </span>
            ) : (
              <span class="rounded-full px-2.5 py-0.5 text-xs font-mono font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 shrink-0">
                Active
              </span>
            )}
          </div>

          <p class="text-sm sm:text-base md:text-lg text-gray-300 leading-relaxed break-words">
            {p.description || "Open-source project on GitHub."}
          </p>

          <!-- Metadata Chips -->
          <div class="flex flex-wrap items-center gap-2 sm:gap-2.5 text-xs font-mono pt-1">
            {p.pinned && (
              <div class="flex items-center gap-1.5 rounded-lg border border-blue-500/30 bg-blue-500/10 px-3 py-1 text-blue-400 font-bold shrink-0">
                <span>Featured</span>
              </div>
            )}

            <!-- Language -->
            <div class="flex items-center gap-2 rounded-lg border border-white/5 bg-white/[0.03] px-3 py-1 text-gray-200 shrink-0">
              <span class="w-2 h-2 rounded-full bg-blue-400"></span>
              <span>{p.language || "Other"}</span>
            </div>

            <!-- Stars -->
            <div class="flex items-center gap-1.5 rounded-lg border border-white/5 bg-white/[0.03] px-3 py-1 text-yellow-400 font-bold shrink-0">
              <Icon name="star" className="w-3.5 h-3.5 fill-current" />
              <span>{p.stars} Stars</span>
            </div>

            <!-- Forks -->
            <div class="flex items-center gap-1.5 rounded-lg border border-white/5 bg-white/[0.03] px-3 py-1 text-cyan-400 font-bold shrink-0">
              <Icon name="git-fork" className="w-3.5 h-3.5" strokeWidth={2} />
              <span>{p.forks} Forks</span>
            </div>

            <!-- License -->
            {p.license && (
              <div class="rounded-lg border border-white/5 bg-white/[0.03] px-3 py-1 text-gray-300 shrink-0">
                License: <span class="text-white font-semibold">{p.license}</span>
              </div>
            )}

            <!-- Updated -->
            {formattedDate && (
              <div class="rounded-lg border border-white/5 bg-white/[0.03] px-3 py-1 text-gray-400 shrink-0">
                Updated: {formattedDate}
              </div>
            )}
          </div>

          <!-- Topics -->
          {p.topics && p.topics.length > 0 && (
            <div class="flex flex-wrap gap-1.5 pt-1">
              {p.topics.map((topic: string) => (
                <span class="rounded-md border border-white/5 bg-white/[0.03] px-2.5 py-0.5 text-xs font-mono text-gray-400">
                  #{topic}
                </span>
              ))}
            </div>
          )}
        </div>

        <!-- Action Buttons (Responsive on Mobile: stacked vertically on mobile, side-by-side on tablet/desktop) -->
        <div class="flex flex-col sm:flex-row lg:flex-col items-stretch sm:items-center lg:items-stretch gap-2.5 sm:gap-3 w-full lg:w-auto shrink-0 pt-2 lg:pt-0">
          <a
            href={p.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600 px-5 py-2.5 text-sm font-semibold text-white transition-all hover:bg-blue-500 shadow-lg shadow-blue-600/20 min-h-[44px] w-full sm:w-auto lg:w-full"
          >
            <Icon name="star" className="w-4 h-4 fill-current text-yellow-300" />
            <span>Star on GitHub</span>
          </a>

          <a
            href={p.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/[0.04] px-5 py-2.5 text-sm font-medium text-gray-200 hover:bg-white/[0.08] hover:text-white transition-all min-h-[44px] w-full sm:w-auto lg:w-full"
          >
            <Icon name="github" className="w-4 h-4" />
            <span>Source Code</span>
            <Icon name="external" className="w-3.5 h-3.5 text-gray-400" />
          </a>

          {p.homepage && p.homepage !== p.repoUrl && (
            <a
              href={p.homepage}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-xl border border-blue-500/20 bg-blue-500/10 px-5 py-2.5 text-sm font-medium text-blue-400 hover:bg-blue-500/20 transition-all min-h-[44px] w-full sm:w-auto lg:w-full"
            >
              <span>Dedicated Page</span>
              <Icon name="arrow-right" className="w-3.5 h-3.5" />
            </a>
          )}
        </div>
      </div>
    </header>

    <!-- 2-Column Responsive Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start min-w-0 max-w-full">

      <!-- LEFT COLUMN: Primary Content with Semantic Tabs (8 Cols) -->
      <main class="lg:col-span-8 space-y-6 min-w-0 max-w-full">

        <!-- Modern Accessible Tab Control (Only rendered if >1 tab exists) -->
        {hasMultipleTabs && (
          <div class="sticky top-[4.5rem] sm:top-20 z-20 pointer-events-none py-1">
            <div
              role="tablist"
              id="project-tablist"
              class="pointer-events-auto inline-flex items-center gap-1.5 bg-[#18181b]/95 backdrop-blur-md border border-white/10 p-1.5 rounded-2xl shadow-xl relative max-w-full overflow-x-auto no-scrollbar"
            >
              <!-- Smooth Sliding Highlight Indicator (mirrors contribution calendar & header) -->
              <div
                id="tab-indicator"
                class="absolute rounded-xl bg-blue-600 shadow-md shadow-blue-600/30 transition-all duration-300 ease-out z-0 pointer-events-none opacity-0"
              ></div>

              <button
                type="button"
                id="tab-btn-readme"
                onclick="window.switchTab('readme')"
                class="tab-btn active relative z-10 h-10 px-4 rounded-xl text-xs sm:text-sm font-semibold transition-colors duration-200 flex items-center gap-2 shrink-0 text-white cursor-pointer select-none"
                role="tab"
                aria-controls="panel-readme"
                aria-selected="true"
              >
                <Icon name="file-text" className="w-4 h-4 text-blue-200 shrink-0" />
                <span>README</span>
              </button>

              {hasTodo && (
                <button
                  type="button"
                  id="tab-btn-todo"
                  onclick="window.switchTab('todo')"
                  class="tab-btn relative z-10 h-10 px-4 rounded-xl text-xs sm:text-sm font-medium transition-colors duration-200 flex items-center gap-2 shrink-0 text-gray-400 hover:text-white cursor-pointer select-none"
                  role="tab"
                  aria-controls="panel-todo"
                  aria-selected="false"
                >
                  <svg class="w-4 h-4 text-amber-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                  </svg>
                  <span>TODO & 路线图</span>
                  {todo?.stats && (
                    <span class="px-2 py-0.5 rounded-full text-[11px] font-mono bg-amber-500/15 text-amber-400 border border-amber-500/25 shrink-0">
                      {todo.stats.percentage}%
                    </span>
                  )}
                </button>
              )}

              {hasReleases && (
                <button
                  type="button"
                  id="tab-btn-releases"
                  onclick="window.switchTab('releases')"
                  class="tab-btn relative z-10 h-10 px-4 rounded-xl text-xs sm:text-sm font-medium transition-colors duration-200 flex items-center gap-2 shrink-0 text-gray-400 hover:text-white cursor-pointer select-none"
                  role="tab"
                  aria-controls="panel-releases"
                  aria-selected="false"
                >
                  <svg class="w-4 h-4 text-purple-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                  <span>Releases</span>
                  {latestRelease && (
                    <span class="px-2 py-0.5 rounded-full text-[11px] font-mono bg-purple-500/15 text-purple-300 border border-purple-500/25 shrink-0">
                      {latestRelease.tagName}
                    </span>
                  )}
                </button>
              )}
            </div>
          </div>
        )}

        <!-- PANEL 1: README (Always available) -->
        <section
          id="panel-readme"
          role="tabpanel"
          aria-labelledby="tab-btn-readme"
          class="tab-panel rounded-2xl md:rounded-3xl border border-white/5 bg-[#18181b] p-4 sm:p-8 md:p-10 shadow-sm min-w-0 max-w-full overflow-hidden"
        >
          <div class="mb-6 pb-4 border-b border-white/5 flex items-center justify-between text-xs font-mono text-gray-400">
            <div class="flex items-center gap-2 text-gray-300">
              <Icon name="file-text" className="w-4 h-4 text-blue-400" />
              <span class="font-bold">README.md</span>
            </div>
            <a
              href={`${p.repoUrl}/blob/${p.defaultBranch}/README.md`}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-blue-400 transition-colors flex items-center gap-1.5"
            >
              <span>View raw on GitHub</span>
              <Icon name="external" className="w-3.5 h-3.5 text-gray-500" />
            </a>
          </div>

          <div class="github-readme prose prose-invert prose-blue max-w-none break-words min-w-0 prose-pre:bg-[#111113] prose-pre:border prose-pre:border-white/5 prose-pre:rounded-xl prose-headings:font-bold prose-headings:text-white prose-a:text-blue-400 hover:prose-a:underline">
            <Content />
          </div>
        </section>

        <!-- PANEL 2: TODO.md (Conditionally Rendered) -->
        {hasTodo && (
          <section
            id="panel-todo"
            role="tabpanel"
            aria-labelledby="tab-btn-todo"
            class="tab-panel hidden rounded-2xl md:rounded-3xl border border-white/5 bg-[#18181b] p-4 sm:p-8 md:p-10 shadow-sm min-w-0 max-w-full overflow-hidden"
          >
            <div class="mb-6 pb-4 border-b border-white/5 flex flex-wrap items-center justify-between gap-3 text-xs font-mono">
              <div class="flex items-center gap-2 text-gray-300">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4" />
                </svg>
                <span class="font-bold">{todo.filename || "TODO.md"} · 路线图与待办事项</span>
              </div>
              {todo.stats && (
                <div class="flex items-center gap-2 text-xs">
                  <span class="text-emerald-400 font-semibold">{todo.stats.completed} 项已完成</span>
                  <span class="text-gray-600">/</span>
                  <span class="text-amber-400 font-semibold">{todo.stats.pending} 项待办</span>
                  <span class="text-gray-600">/</span>
                  <span class="text-gray-400">共 {todo.stats.total} 项</span>
                </div>
              )}
            </div>

            <!-- Visual Progress Bar Card -->
            {todo.stats && todo.stats.total > 0 && (
              <div class="bg-white/[0.02] border border-white/5 rounded-2xl p-4 sm:p-5 mb-8">
                <div class="flex items-center justify-between text-xs font-mono mb-2.5">
                  <span class="text-gray-300 font-semibold">{p.name} 开发路线图完成度</span>
                  <span class="text-blue-400 font-bold">{todo.stats.percentage}% Complete</span>
                </div>
                <div class="w-full h-3 bg-white/10 rounded-full overflow-hidden p-0.5">
                  <div
                    class="h-full bg-gradient-to-r from-blue-500 via-cyan-400 to-emerald-400 rounded-full transition-all duration-500"
                    style={`width: ${Math.max(todo.stats.percentage, 4)}%`}
                  ></div>
                </div>
                <p class="mt-2.5 text-xs text-gray-400">
                  数据提取自最新 Git 主干仓库内 <code>{todo.filename}</code> 规范任务列表。
                </p>
              </div>
            )}

            <!-- Rendered Markdown for TODO -->
            <div
              class="github-readme prose prose-invert prose-blue max-w-none break-words min-w-0 prose-pre:bg-[#111113] prose-pre:border prose-pre:border-white/5 prose-pre:rounded-xl prose-headings:font-bold prose-headings:text-white prose-a:text-blue-400 hover:prose-a:underline"
              set:html={todoHtml}
            />
          </section>
        )}

        <!-- PANEL 3: Releases (Conditionally Rendered) -->
        {hasReleases && (
          <section
            id="panel-releases"
            role="tabpanel"
            aria-labelledby="tab-btn-releases"
            class="tab-panel hidden rounded-2xl md:rounded-3xl border border-white/5 bg-[#18181b] p-4 sm:p-8 md:p-10 shadow-sm min-w-0 max-w-full overflow-hidden"
          >
            <div class="mb-6 pb-4 border-b border-white/5 flex items-center justify-between text-xs font-mono text-gray-400">
              <div class="flex items-center gap-2 text-gray-300">
                <svg class="w-4 h-4 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                </svg>
                <span class="font-bold">Releases · 版本发版与更新日志</span>
              </div>
              <span class="text-gray-500">GitHub Releases API</span>
            </div>

            <!-- Releases Timeline -->
            <div class="space-y-8 relative before:absolute before:inset-0 before:left-3.5 before:w-0.5 before:bg-white/10">
              {parsedReleases.map((release: any, idx: number) => {
                const isLatest = idx === 0;
                const releaseDate = release.publishedAt
                  ? new Date(release.publishedAt).toLocaleDateString("en-US", {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })
                  : "";

                return (
                  <div class="relative pl-7 sm:pl-8 space-y-3 min-w-0">
                    <div
                      class={`absolute left-1.5 top-2 w-4 h-4 rounded-full border-4 border-[#18181b] ${
                        isLatest ? "bg-blue-500" : "bg-white/30"
                      }`}
                    ></div>

                    <div class="flex flex-wrap items-center justify-between gap-2">
                      <div class="flex items-center gap-2.5">
                        <h3 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                          <a
                            href={release.htmlUrl}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="hover:text-blue-400 transition-colors"
                          >
                            {release.name || release.tagName}
                          </a>
                        </h3>
                        {isLatest && (
                          <span class="px-2 py-0.5 rounded text-xs font-mono bg-blue-500/20 text-blue-400 border border-blue-500/30">
                            Latest
                          </span>
                        )}
                        {release.prerelease && (
                          <span class="px-2 py-0.5 rounded text-xs font-mono bg-purple-500/20 text-purple-300 border border-purple-500/30">
                            Pre-release
                          </span>
                        )}
                      </div>
                      {releaseDate && (
                        <time class="text-xs font-mono text-gray-400" datetime={release.publishedAt}>
                          {releaseDate}
                        </time>
                      )}
                    </div>

                    <!-- Changelog body -->
                    {release.bodyHtml && (
                      <div
                        class="p-4 sm:p-5 rounded-2xl border border-white/5 bg-white/[0.015] github-readme prose prose-invert prose-blue max-w-none text-xs sm:text-sm text-gray-300 min-w-0"
                        set:html={release.bodyHtml}
                      />
                    )}

                    <!-- Downloadable Assets -->
                    {release.assets && release.assets.length > 0 && (
                      <div class="pt-2 space-y-2">
                        <span class="text-xs font-mono text-gray-400 uppercase tracking-wider">
                          Release Assets ({release.assets.length}):
                        </span>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                          {release.assets.map((asset: any) => (
                            <a
                              href={asset.downloadUrl}
                              target="_blank"
                              rel="noopener noreferrer"
                              class="flex items-center justify-between p-3 rounded-xl border border-white/10 bg-white/[0.02] hover:bg-blue-600/10 hover:border-blue-500/30 transition-all group min-w-0"
                            >
                              <div class="flex items-center gap-2.5 truncate mr-2 min-w-0">
                                <svg
                                  class="w-4 h-4 text-blue-400 group-hover:scale-110 transition-transform shrink-0"
                                  fill="none"
                                  stroke="currentColor"
                                  viewBox="0 0 24 24"
                                >
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
                                </svg>
                                <span class="text-xs font-mono text-gray-200 group-hover:text-white truncate">
                                  {asset.name}
                                </span>
                              </div>
                              <div class="flex items-center gap-1.5 text-[11px] font-mono text-gray-400 shrink-0">
                                <span>{formatBytes(asset.size)}</span>
                                {asset.downloadCount > 0 && (
                                  <span class="text-gray-500">· {asset.downloadCount} dl</span>
                                )}
                              </div>
                            </a>
                          ))}
                        </div>
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          </section>
        )}

      </main>

      <!-- RIGHT COLUMN: Sticky Intelligence Sidebar (4 Cols) -->
      <aside class="lg:col-span-4 space-y-6 lg:sticky lg:top-20 min-w-0 max-w-full">

        <!-- Widget 1: Quick Access & Install Card -->
        <div class="rounded-2xl border border-white/5 bg-[#18181b] p-5 sm:p-6 shadow-sm space-y-4 min-w-0">
          <div class="flex items-center justify-between">
            <h2 class="text-xs font-mono uppercase tracking-wider text-gray-400 font-bold flex items-center gap-2">
              <svg class="w-4 h-4 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4" />
              </svg>
              <span>Quick Access & Install</span>
            </h2>
            {latestRelease && (
              <span class="text-[11px] font-mono text-blue-400 font-bold">
                {latestRelease.tagName}
              </span>
            )}
          </div>

          <!-- Quick Clone URL snippet -->
          <div class="space-y-1.5">
            <div class="flex items-center justify-between text-xs text-gray-400">
              <span>Git Clone URL</span>
              <button
                id="copy-btn"
                onclick={`window.copyToClipboard('${p.repoUrl}.git')`}
                class="text-blue-400 hover:text-blue-300 text-xs flex items-center gap-1 font-mono transition-colors cursor-pointer"
              >
                <Icon name="copy" className="w-3.5 h-3.5" />
                <span id="copy-btn-text">Copy</span>
              </button>
            </div>
            <div class="p-2.5 rounded-xl bg-[#111113] border border-white/5 font-mono text-xs text-gray-300 break-all select-all">
              <code>git clone {p.repoUrl}.git</code>
            </div>
          </div>

          <!-- Navigate to Releases Tab Button (User choice: avoids wrong-platform auto-download) -->
          {hasReleases ? (
            <button
              type="button"
              onclick="window.switchTabAndScroll('releases')"
              class="w-full inline-flex items-center justify-center gap-2 rounded-xl bg-blue-600/15 border border-blue-500/30 px-4 py-2.5 text-xs font-semibold text-blue-400 hover:bg-blue-600/25 transition-all cursor-pointer group"
            >
              <svg class="w-4 h-4 text-purple-400 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
              </svg>
              <span>浏览 Releases 跨平台安装包 →</span>
            </button>
          ) : (
            <a
              href={p.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="w-full inline-flex items-center justify-center gap-2 rounded-xl border border-white/10 bg-white/[0.03] px-4 py-2.5 text-xs font-semibold text-gray-300 hover:bg-white/[0.06] hover:text-white transition-all"
            >
              <Icon name="github" className="w-4 h-4" />
              <span>Explore GitHub Repository</span>
            </a>
          )}
        </div>

        <!-- Widget 2: Roadmap Pulse (Only rendered if TODO exists) -->
        {hasTodo && todo.stats && (
          <div class="rounded-2xl border border-white/5 bg-[#18181b] p-5 sm:p-6 shadow-sm space-y-4 min-w-0">
            <div class="flex items-center justify-between">
              <h2 class="text-xs font-mono uppercase tracking-wider text-gray-400 font-bold flex items-center gap-2">
                <svg class="w-4 h-4 text-amber-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
                <span>Roadmap Pulse (TODO)</span>
              </h2>
              <span class="text-xs font-mono text-blue-400 font-bold">
                {todo.stats.percentage}%
              </span>
            </div>

            <div class="w-full h-2 bg-white/10 rounded-full overflow-hidden">
              <div
                class="h-full bg-blue-500 rounded-full transition-all duration-500"
                style={`width: ${Math.max(todo.stats.percentage, 4)}%`}
              ></div>
            </div>

            <div class="space-y-2 text-xs">
              <div class="flex items-center justify-between text-gray-400">
                <span>任务执行状态:</span>
                <span class="text-gray-200 font-mono">
                  {todo.stats.completed} 完成 / {todo.stats.pending} 待办
                </span>
              </div>
              {relativeUpdate && (
                <div class="flex items-center justify-between text-gray-400">
                  <span>最后追踪变动:</span>
                  <span class="text-emerald-400 font-mono">{relativeUpdate}</span>
                </div>
              )}
            </div>

            <button
              type="button"
              onclick="window.switchTabAndScroll('todo')"
              class="w-full text-center text-xs text-amber-400 hover:text-amber-300 font-medium py-2 rounded-xl border border-amber-500/20 bg-amber-500/5 hover:bg-amber-500/10 transition-colors cursor-pointer"
            >
              查看完整路线图清单 →
            </button>
          </div>
        )}

        <!-- Widget 3: 近似项目 (Related Projects via GitHub Topics) -->
        {relatedProjects.length > 0 && (
          <div class="rounded-2xl border border-white/5 bg-[#18181b] p-5 sm:p-6 shadow-sm space-y-3 min-w-0">
            <h2 class="text-xs font-mono uppercase tracking-wider text-gray-400 font-bold flex items-center gap-2">
              <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
              <span>近似项目 (Related Projects)</span>
            </h2>

            <div class="space-y-2.5 pt-1">
              {relatedProjects.map((item: any) => (
                <a
                  href={`/projects/${item.project.slug || item.project.name.toLowerCase()}`}
                  class="block p-3 rounded-xl border border-white/5 bg-white/[0.015] hover:bg-white/[0.04] hover:border-white/10 transition-all group min-w-0"
                >
                  <div class="flex items-center justify-between">
                    <span class="text-xs font-mono font-bold text-gray-200 group-hover:text-blue-400 transition-colors truncate">
                      {item.project.name}
                    </span>
                    <span class="flex items-center gap-1 text-[11px] font-mono text-yellow-400/80 shrink-0">
                      <Icon name="star" className="w-3 h-3 fill-current" />
                      <span>{item.project.stars}</span>
                    </span>
                  </div>

                  {item.project.description && (
                    <p class="text-[11px] text-gray-400 line-clamp-1 mt-1 font-sans">
                      {item.project.description}
                    </p>
                  )}

                  {item.shared && item.shared.length > 0 && (
                    <div class="flex flex-wrap gap-1 mt-2">
                      {item.shared.map((tag: string) => (
                        <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-400/90 border border-blue-500/20">
                          #{tag}
                        </span>
                      ))}
                    </div>
                  )}
                </a>
              ))}
            </div>
          </div>
        )}

        <!-- Widget 4: Repository Details (Metadata) -->
        <div class="rounded-2xl border border-white/5 bg-[#18181b] p-5 sm:p-6 shadow-sm space-y-3 text-xs font-mono text-gray-400 min-w-0">
          <h2 class="uppercase tracking-wider font-bold text-gray-300">
            Repository Details
          </h2>
          <div class="divide-y divide-white/5 space-y-2.5">
            <div class="flex justify-between pt-2.5">
              <span>Default Branch</span>
              <span class="text-white font-medium">{p.defaultBranch}</span>
            </div>
            <div class="flex justify-between pt-2.5">
              <span>Primary Language</span>
              <span class="text-white font-medium">{p.language || "Other"}</span>
            </div>
            {p.license && (
              <div class="flex justify-between pt-2.5">
                <span>License</span>
                <span class="text-white font-medium">{p.license}</span>
              </div>
            )}
            {relativeUpdate && (
              <div class="flex justify-between pt-2.5">
                <span>Last Updated</span>
                <span class="text-white font-medium">{relativeUpdate}</span>
              </div>
            )}
          </div>
        </div>

      </aside>

    </div>
  </div>

  <script is:inline>
    // Smooth sliding highlight indicator (matches ContributionCalendar and HeaderNav)
    function updateTabIndicator(targetBtn, smooth = true) {
      const indicator = document.getElementById("tab-indicator");
      if (!indicator || !targetBtn) return;

      if (!smooth) {
        indicator.style.transition = "none";
      } else {
        indicator.style.transition = "all 300ms cubic-bezier(0.16, 1, 0.3, 1)";
      }

      indicator.style.left = `${targetBtn.offsetLeft}px`;
      indicator.style.top = `${targetBtn.offsetTop}px`;
      indicator.style.width = `${targetBtn.offsetWidth}px`;
      indicator.style.height = `${targetBtn.offsetHeight}px`;
      indicator.style.opacity = "1";

      if (!smooth) {
        void indicator.offsetHeight;
        indicator.style.transition = "";
      }
    }

    // Tab switching logic compliant with accessible ARIA standards & URL fragments
    window.switchTab = function (tabId) {
      const tabs = ["readme", "todo", "releases"];
      tabs.forEach((t) => {
        const btn = document.getElementById(`tab-btn-${t}`);
        const panel = document.getElementById(`panel-${t}`);
        if (!panel) return;

        if (t === tabId) {
          if (btn) {
            btn.classList.add("text-white", "font-semibold");
            btn.classList.remove("text-gray-400", "font-medium");
            btn.setAttribute("aria-selected", "true");
            updateTabIndicator(btn, true);
          }
          panel.classList.remove("hidden");
        } else {
          if (btn) {
            btn.classList.remove("text-white", "font-semibold");
            btn.classList.add("text-gray-400", "font-medium");
            btn.setAttribute("aria-selected", "false");
          }
          panel.classList.add("hidden");
        }
      });

      // Update URL hash without forcing full page reload
      if (window.history && window.history.replaceState) {
        window.history.replaceState(null, "", "#" + tabId);
      }
    };

    // Switch tab and smooth scroll to target panel (with fixed header offset compensation)
    window.switchTabAndScroll = function (tabId) {
      window.switchTab(tabId);
      const panel = document.getElementById("panel-" + tabId);
      if (panel) {
        // Offset for 64px fixed header + 26px breathing room
        const headerOffset = 90;
        const elementPosition = panel.getBoundingClientRect().top;
        const offsetPosition = elementPosition + window.pageYOffset - headerOffset;
        window.scrollTo({
          top: offsetPosition,
          behavior: "smooth",
        });
      }
    };

    // Deep-linking support and indicator initialization on mount
    function initTabs() {
      const hash = window.location.hash.replace("#", "");
      const activeTab = ["readme", "todo", "releases"].includes(hash) ? hash : "readme";
      const targetBtn = document.getElementById(`tab-btn-${activeTab}`) || document.getElementById("tab-btn-readme");

      window.switchTab(activeTab);

      if (targetBtn) {
        requestAnimationFrame(() => {
          updateTabIndicator(targetBtn, false);
        });
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(() => {
            const curBtn = document.querySelector(".tab-btn[aria-selected='true']");
            if (curBtn) updateTabIndicator(curBtn, false);
          });
        }
      }
    }

    window.addEventListener("DOMContentLoaded", initTabs);
    window.addEventListener("resize", () => {
      const curBtn = document.querySelector(".tab-btn[aria-selected='true']");
      if (curBtn) updateTabIndicator(curBtn, false);
    });

    // Copy to clipboard helper
    window.copyToClipboard = function (text) {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(text);
        const label = document.getElementById("copy-btn-text");
        if (label) {
          const original = label.innerText;
          label.innerText = "Copied!";
          setTimeout(() => {
            label.innerText = original;
          }, 2000);
        }
      }
    };
  </script>
</Layout>
