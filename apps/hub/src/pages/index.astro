---
import Layout from "../layouts/Layout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Icon from "@mozi/ui/Icon.astro";
import projects from "../data/projects.json";
import stats from "../data/stats.json";

// Pinned projects sorted by their GitHub profile pinnedOrder
const pinnedProjects = projects
  .filter((p) => p.pinned)
  .sort((a, b) => (a.pinnedOrder ?? 99) - (b.pinnedOrder ?? 99));

// Initial sort: Pinned first, then by stars
const initialProjects = [...projects].sort((a, b) => {
  if (a.pinned && !b.pinned) return -1;
  if (!a.pinned && b.pinned) return 1;
  if (a.pinned && b.pinned) return (a.pinnedOrder ?? 99) - (b.pinnedOrder ?? 99);
  return b.stars - a.stars;
});

const uniqueLanguages = ["All", ...Object.keys(stats.languages).sort()];
---

<Layout
  title="Mozi's Open Source Hub | GitHub Projects & Repositories"
  description="Explore public GitHub repositories and open-source projects by Mozi Arasaka: Blender tools, Rust engines, AI models, and web applications."
  schemaType="profile"
>
  <!-- Hero Section Aligned with Web Design Language -->
  <section class="relative overflow-hidden pt-12 pb-10 md:pt-16 md:pb-14 bg-[#111]">
    <!-- Subtle Ambient Glow -->
    <div class="pointer-events-none absolute top-0 left-1/2 -translate-x-1/2 w-[500px] h-[250px] bg-blue-500/5 blur-[100px] rounded-full"></div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col items-center text-center max-w-3xl mx-auto">
        <!-- Refined Pill Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-blue-500/20 bg-blue-500/10 text-xs font-mono text-blue-400 mb-4">
          <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
          <span>Mozi's Code & Ecosystem</span>
        </div>

        <h1 class="text-3xl sm:text-5xl md:text-6xl font-bold tracking-tight text-white">
          Open Source <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-indigo-400">Hub</span>
        </h1>

        <p class="mt-3 text-sm sm:text-base md:text-lg text-gray-400 leading-relaxed max-w-2xl">
          Curated open-source projects, high-performance Rust engines, Blender DCC pipeline tools, and AI utilities by Mozi Arasaka.
        </p>

        <!-- Compact, Tasteful Stats Strip -->
        <div class="mt-6 flex flex-wrap items-center justify-center gap-3 sm:gap-8 rounded-2xl border border-white/5 bg-white/[0.02] px-5 py-3 text-xs sm:text-sm font-mono text-gray-300">
          <div class="flex items-center gap-2">
            <span class="font-bold text-white text-base">{stats.totalProjects}</span>
            <span class="text-gray-400">Repositories</span>
          </div>
          <span class="text-white/20 hidden sm:inline">|</span>
          <div class="flex items-center gap-1.5">
            <Icon name="star" className="w-3.5 h-3.5 text-yellow-400 fill-current" />
            <span class="font-bold text-yellow-400 text-base">{stats.totalStars}</span>
            <span class="text-gray-400">Stars</span>
          </div>
          <span class="text-white/20 hidden sm:inline">|</span>
          <div class="flex items-center gap-1.5">
            <Icon name="git-fork" className="w-3.5 h-3.5 text-cyan-400" strokeWidth={2} />
            <span class="font-bold text-cyan-400 text-base">{stats.totalForks}</span>
            <span class="text-gray-400">Forks</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured / Pinned Projects Showcase -->
  {pinnedProjects.length > 0 && (
    <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 pb-6">
      <div class="flex items-center justify-between mb-6">
        <div class="flex items-center gap-2.5">
          <span class="w-2 h-2 rounded-full bg-blue-400"></span>
          <h2 class="text-xl sm:text-2xl font-bold text-white tracking-tight flex items-center gap-2">
            <span>Featured Projects</span>
            <span class="text-xs font-mono px-2 py-0.5 rounded bg-blue-500/10 text-blue-400 border border-blue-500/20">PINNED</span>
          </h2>
        </div>
        <a
          href="https://github.com/mozi1924"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs font-mono text-gray-400 hover:text-blue-400 transition-colors flex items-center gap-1"
        >
          <span>From GitHub Profile</span>
          <Icon name="external" className="w-3 h-3" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
        {pinnedProjects.map((project) => (
          <ProjectCard project={project} showPinnedBadge={false} />
        ))}
      </div>
    </section>
  )}

  <!-- Filter & Search Controls for All Repositories -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-8 pb-4">
    <div class="flex items-center justify-between mb-4">
      <h2 class="text-lg sm:text-xl font-bold text-white tracking-tight flex items-center gap-2">
        <span>All Repositories</span>
        <span class="text-xs font-mono text-gray-500 font-normal">({projects.length})</span>
      </h2>
    </div>

    <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3 sm:gap-4">
      <!-- Search Input -->
      <div class="relative flex-1 max-w-md">
        <Icon name="search" className="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400 pointer-events-none" />
        <input
          id="project-search"
          type="text"
          placeholder="Search by name, topic, or keyword..."
          class="w-full pl-10 pr-8 py-2.5 bg-[#161619] border border-white/10 rounded-xl text-sm text-white placeholder-gray-500 focus:outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 transition-colors min-h-[44px]"
        />
        <button
          id="search-clear"
          type="button"
          class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-500 hover:text-white p-1 rounded focus:outline-none"
          aria-label="Clear search"
        >
          <Icon name="x" className="w-3.5 h-3.5" />
        </button>
      </div>

      <!-- Sorting Select -->
      <div class="flex items-center gap-2 justify-between sm:justify-end">
        <label for="sort-select" class="text-xs text-gray-400 font-mono shrink-0">SORT BY:</label>
        <div class="relative">
          <select
            id="sort-select"
            class="bg-[#161619] border border-white/10 rounded-xl px-3 pr-8 py-2 text-xs font-medium text-gray-300 focus:outline-none focus:border-blue-500 cursor-pointer appearance-none min-h-[38px]"
          >
            <option value="pinned">Pinned First (📌)</option>
            <option value="stars">Most Stars (★)</option>
            <option value="updated">Recently Updated</option>
            <option value="name">Name (A-Z)</option>
          </select>
          <div class="pointer-events-none absolute right-2.5 top-1/2 -translate-y-1/2 text-gray-400">
            <Icon name="chevron-down" className="w-3.5 h-3.5" />
          </div>
        </div>
      </div>
    </div>

    <!-- Horizontally Scrollable Language Filter Pills on Mobile -->
    <div
      class="mt-4 flex items-center gap-1.5 overflow-x-auto no-scrollbar py-1 -mx-4 px-4 sm:mx-0 sm:px-0 sm:flex-wrap"
      id="language-filters"
    >
      {uniqueLanguages.map((lang, index) => (
        <button
          type="button"
          data-lang={lang.toLowerCase()}
          class={`filter-btn shrink-0 px-3 py-1.5 rounded-lg text-xs font-mono transition-all cursor-pointer min-h-[36px] flex items-center ${
            index === 0
              ? "active bg-blue-500/15 text-blue-400 border border-blue-500/30 font-bold shadow-sm"
              : "border border-white/10 bg-white/[0.02] text-gray-400 hover:text-white hover:bg-white/[0.05]"
          }`}
        >
          {lang} {lang !== "All" && `(${stats.languages[lang as keyof typeof stats.languages] || 0})`}
        </button>
      ))}
    </div>
  </section>

  <!-- Projects Grid -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pb-20 md:pb-28">
    <div id="projects-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      {initialProjects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>

    <!-- No Results Fallback -->
    <div id="no-results" class="hidden text-center py-16 border border-white/5 rounded-2xl bg-white/[0.01]">
      <div class="mx-auto w-12 h-12 rounded-full bg-white/5 flex items-center justify-center text-gray-500 mb-3">
        <Icon name="search" className="w-6 h-6" />
      </div>
      <h3 class="text-base font-bold text-gray-300">No matching projects found</h3>
      <p class="text-xs text-gray-500 mt-1">Try searching with different keywords or selecting "All" languages.</p>
    </div>
  </section>
</Layout>

<script>
  function setupFilters() {
    const searchInput = document.getElementById("project-search") as HTMLInputElement;
    const searchClear = document.getElementById("search-clear");
    const sortSelect = document.getElementById("sort-select") as HTMLSelectElement;
    const filterButtons = document.querySelectorAll(".filter-btn");
    const grid = document.getElementById("projects-grid");
    const noResults = document.getElementById("no-results");
    if (!grid) return;
    const projectGrid = grid;

    let selectedLang = "all";
    let searchQuery = "";
    let sortMode = "pinned";

    function update() {
      const cards = Array.from(projectGrid.querySelectorAll("[data-name]")) as HTMLElement[];
      let visibleCount = 0;

      cards.forEach((card) => {
        const name = card.dataset.name || "";
        const desc = card.dataset.description || "";
        const lang = card.dataset.language || "";
        const topics = card.dataset.topics || "";

        const matchesSearch =
          !searchQuery ||
          name.includes(searchQuery) ||
          desc.includes(searchQuery) ||
          topics.includes(searchQuery);

        const matchesLang =
          selectedLang === "all" || lang === selectedLang;

        if (matchesSearch && matchesLang) {
          card.classList.remove("hidden");
          visibleCount++;
        } else {
          card.classList.add("hidden");
        }
      });

      // Sort visible cards
      cards.sort((a, b) => {
        if (sortMode === "pinned") {
          const aPinned = a.dataset.pinned === "true" ? 1 : 0;
          const bPinned = b.dataset.pinned === "true" ? 1 : 0;
          if (aPinned !== bPinned) return bPinned - aPinned;
          if (aPinned && bPinned) {
            return (Number(a.dataset.pinnedOrder) || 0) - (Number(b.dataset.pinnedOrder) || 0);
          }
          return (Number(b.dataset.stars) || 0) - (Number(a.dataset.stars) || 0);
        } else if (sortMode === "stars") {
          return (Number(b.dataset.stars) || 0) - (Number(a.dataset.stars) || 0);
        } else if (sortMode === "updated") {
          return new Date(b.dataset.updated || 0).getTime() - new Date(a.dataset.updated || 0).getTime();
        } else if (sortMode === "name") {
          return (a.dataset.name || "").localeCompare(b.dataset.name || "");
        }
        return 0;
      });

      cards.forEach((card) => projectGrid.appendChild(card));

      if (noResults) {
        if (visibleCount === 0) {
          noResults.classList.remove("hidden");
        } else {
          noResults.classList.add("hidden");
        }
      }

      if (searchClear) {
        if (searchQuery) {
          searchClear.classList.remove("hidden");
        } else {
          searchClear.classList.add("hidden");
        }
      }
    }

    searchInput?.addEventListener("input", (e) => {
      searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
      update();
    });

    searchClear?.addEventListener("click", () => {
      if (searchInput) {
        searchInput.value = "";
        searchQuery = "";
        update();
        searchInput.focus();
      }
    });

    sortSelect?.addEventListener("change", (e) => {
      sortMode = (e.target as HTMLSelectElement).value;
      update();
    });

    filterButtons.forEach((btn) => {
      btn.addEventListener("click", () => {
        filterButtons.forEach((b) => {
          b.classList.remove("active", "bg-blue-500/15", "text-blue-400", "border-blue-500/30", "font-bold", "shadow-sm");
          b.classList.add("border-white/10", "bg-white/[0.02]", "text-gray-400");
        });
        btn.classList.add("active", "bg-blue-500/15", "text-blue-400", "border-blue-500/30", "font-bold", "shadow-sm");
        btn.classList.remove("border-white/10", "bg-white/[0.02]", "text-gray-400");
        selectedLang = (btn as HTMLElement).dataset.lang || "all";
        update();
      });
    });
  }

  // Run on mount
  setupFilters();
  document.addEventListener("astro:page-load", setupFilters);
</script>

<style>
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>
