---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import BaseHead from "@mozi/ui/BaseHead.astro";
import StructuredData from "@mozi/ui/StructuredData.astro";
import { MOZI_IDENTITY } from "@mozi/ui/siteConfig";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  schemaType?: "website" | "webpage" | "article" | "blog" | "profile" | "software";
  software?: {
    name: string;
    description?: string;
    codeRepository?: string;
    programmingLanguage?: string;
    license?: string;
    version?: string;
    softwareVersion?: string;
    dateCreated?: string | Date;
    dateModified?: string | Date;
    keywords?: string[] | string;
    image?: string;
    runtimePlatform?: string;
    applicationCategory?: string;
  };
  breadcrumbs?: { name: string; item: string }[];
  items?: { name: string; url: string; image?: string; description?: string }[];
  schemaData?: Record<string, any>;
}

const {
  title = "Mozi's Open Source Hub | Projects & Repositories",
  description = "Explore open-source repositories by Mozi Arasaka: high-performance Rust engines, Blender DCC extensions, Minecraft tooling, and machine learning utilities.",
  image = "/avatar.webp",
  type = "website",
  schemaType,
  software,
  breadcrumbs,
  items,
  schemaData,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || MOZI_IDENTITY.hubUrl);
const formattedTitle = title.includes("Mozi") ? title : `${title} | Mozi's Open Source Hub`;
const ogImageUrl = image.startsWith("http")
  ? image
  : new URL(image, Astro.site || MOZI_IDENTITY.hubUrl).href;
---

<!doctype html>
<html lang="en" class="scroll-smooth bg-[#111] text-gray-100 antialiased">
  <head>
    <BaseHead
      title={formattedTitle}
      description={description}
      canonicalURL={canonicalURL}
      image={ogImageUrl}
      type={type}
    >
      <!-- SSOT Schema.org JSON-LD -->
      {schemaType ? (
        <StructuredData
          type={schemaType}
          title={formattedTitle}
          description={description}
          canonicalURL={canonicalURL}
          image={ogImageUrl}
          software={software}
          breadcrumbs={breadcrumbs}
          items={items}
          customSchema={schemaData}
        />
      ) : schemaData ? (
        <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
      ) : (
        <StructuredData
          type="website"
          title={formattedTitle}
          description={description}
          canonicalURL={canonicalURL}
          image={ogImageUrl}
          breadcrumbs={breadcrumbs}
          items={items}
        />
      )}
    </BaseHead>
  </head>
  <body class="bg-[#111] min-h-[100dvh] flex flex-col selection:bg-blue-500/30 selection:text-white font-sans">
    <Header />
    <main class="flex-grow pt-16" transition:animate="fade">
      <slot />
    </main>
    <Footer />
  </body>
</html>
