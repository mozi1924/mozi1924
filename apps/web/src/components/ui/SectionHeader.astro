---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<div class="text-center space-y-3 mb-12 md:mb-16">
  <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white tracking-tight">{title}</h1>
  <div class="w-12 h-1 bg-white mx-auto rounded-full"></div>
  <slot />
</div>
