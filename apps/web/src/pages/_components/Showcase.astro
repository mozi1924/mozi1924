---
import ProjectCard from "@mozi/ui/ProjectCard.astro";
import { pinnedProjects } from "@mozi/ui/pinnedProjects";
import Icon from "@mozi/ui/Icon.astro";

// Sort by pinnedOrder
const projects = [...pinnedProjects].sort(
  (a, b) => (a.pinnedOrder ?? 99) - (b.pinnedOrder ?? 99)
);
---

<section id="showcase" class="py-20 md:py-28 bg-[#111] px-4 sm:px-6 border-t border-white/5">
  <div class="max-w-6xl mx-auto space-y-12 md:space-y-16">
    <!-- Refined Showcase Heading -->
    <div class="text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-blue-500/10 text-blue-400 text-xs font-mono mb-3 border border-blue-500/20">
        <span class="w-1.5 h-1.5 rounded-full bg-blue-400"></span>
        Featured Creations & Ecosystem
      </div>
      <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-white tracking-tight">
        Showcase
      </h2>
      <p class="text-gray-400 text-sm sm:text-base mt-3 leading-relaxed">
        High-performance Blender DCC extensions, Minecraft character rigging systems, and open-source AI utilities.
      </p>
    </div>

    <!-- Pinned Project Cards Grid (Referencing Blog Card Design & Hover Motion) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6 md:gap-8">
      {projects.map((project) => (
        <ProjectCard
          project={project}
          variant="showcase"
          showPinnedBadge={false}
          hubBaseUrl="https://hub.mozi1924.com"
        />
      ))}
    </div>

    <!-- Polished Action Link to Full Hub -->
    <div class="text-center pt-2">
      <a
        href="https://hub.mozi1924.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-white/10 bg-white/[0.03] text-sm font-medium text-gray-300 hover:text-white hover:bg-white/[0.08] hover:border-white/20 transition-all group"
      >
        <span>Explore all projects on Open Source Hub</span>
        <Icon name="arrow-right" className="w-4 h-4 text-blue-400 transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</section>
