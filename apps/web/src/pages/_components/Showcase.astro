---
import ProjectCard from "@mozi/ui/ProjectCard.astro";
import { pinnedProjects } from "@mozi/ui/pinnedProjects";
import Icon from "@mozi/ui/Icon.astro";

// Sort by pinnedOrder
const projects = [...pinnedProjects].sort(
  (a, b) => (a.pinnedOrder ?? 99) - (b.pinnedOrder ?? 99)
);
---

<section class="py-24 bg-[#161616] px-6">
  <div class="max-w-6xl mx-auto space-y-16">
    <!-- Centered Classic Showcase Heading with Divider Line -->
    <div class="text-center space-y-4">
      <h2 class="text-3xl font-bold text-white tracking-tight">Showcase</h2>
      <div class="w-20 h-1 bg-white mx-auto rounded-full"></div>
    </div>

    <!-- Pinned Project Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {projects.map((project) => (
        <ProjectCard
          project={project}
          showPinnedBadge={false}
          hubBaseUrl="https://hub.mozi1924.com"
        />
      ))}
    </div>

    <!-- Subtle Link to Full Hub -->
    <div class="text-center pt-2">
      <a
        href="https://hub.mozi1924.com"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-white transition-colors group"
      >
        <span>Explore all projects on Open Source Hub</span>
        <Icon name="arrow-right" className="w-4 h-4 text-blue-400 transition-transform group-hover:translate-x-1" />
      </a>
    </div>
  </div>
</section>
