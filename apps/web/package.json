{
  "name": "@mozi/web",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "check": "node scripts/check-runtime.mjs && astro check",
    "dev": "node scripts/check-runtime.mjs && astro dev --host",
    "build": "node scripts/check-runtime.mjs && astro build && pagefind --site dist/client && node scripts/prepare-pages-build.mjs",
    "preview": "node scripts/check-runtime.mjs && rm -rf .wrangler/deploy && wrangler pages dev dist",
    "astro": "astro",
    "new": "node scripts/new-post.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@marsidev/react-turnstile": "^1.6.3",
    "@mozi/ui": "workspace:*",
    "@tabler/icons-react": "^3.50.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.65.0",
    "mermaid": "^12.2.0",
    "overlayscrollbars": "^2.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@tailwindcss/typography": "^0.5.20",
    "esbuild": "^0.28.2",
    "pagefind": "^1.5.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}