{
  "name": "@mozi/web",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "precheck": "node scripts/check-runtime.mjs",
    "check": "astro check",
    "predev": "node scripts/check-runtime.mjs",
    "dev": "astro dev --host",
    "prebuild": "node scripts/check-runtime.mjs",
    "build": "astro build && pagefind --site dist/client && node scripts/prepare-pages-build.mjs",
    "preview": "node scripts/check-runtime.mjs && rm -rf .wrangler/deploy && wrangler pages dev dist",
    "astro": "astro",
    "new": "node scripts/new-post.mjs",
    "archive": "node scripts/archive-to-wayback.mjs",
    "archive:changed": "node scripts/archive-to-wayback.mjs --mode=changed",
    "archive:all": "node scripts/archive-to-wayback.mjs --mode=all"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "catalog:",
    "@marsidev/react-turnstile": "^1.6.3",
    "@mozi/ui": "workspace:*",
    "@tabler/icons-react": "^3.50.0",
    "@tailwindcss/vite": "catalog:",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "catalog:",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.65.0",
    "mermaid": "^12.2.0",
    "overlayscrollbars": "^2.17.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "catalog:",
    "turndown": "^7.2.4",
    "typescript": "catalog:"
  },
  "devDependencies": {
    "@astrojs/check": "catalog:",
    "@cloudflare/workers-types": "^5.20261030.1",
    "@tailwindcss/typography": "catalog:",
    "esbuild": "^0.28.2",
    "pagefind": "^1.5.2",
    "vite": "^8.3.5",
    "wrangler": "^4.156.0"
  }
}