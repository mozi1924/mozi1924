{
  "name": "@mozi/web",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "check:runtime": "node scripts/check-runtime.mjs",
    "check": "node scripts/check-runtime.mjs && astro check",
    "dev": "node scripts/check-runtime.mjs && astro dev --host",
    "build": "node scripts/check-runtime.mjs && astro build && pagefind --site dist/client && node scripts/prepare-pages-build.mjs",
    "preview": "node scripts/check-runtime.mjs && rm -rf .wrangler/deploy && wrangler pages dev dist",
    "astro": "astro",
    "new": "node scripts/new-post.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.1.5",
    "@astrojs/mdx": "^5.0.3",
    "@astrojs/react": "^5.0.2",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.4",
    "@marsidev/react-turnstile": "^1.5.0",
    "@tabler/icons-react": "^3.50.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.1.2",
    "date-fns": "^4.1.0",
    "lucide-react": "^1.7.0",
    "mermaid": "^11.14.0",
    "overlayscrollbars": "^2.14.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.3.3",
    "turndown": "^7.2.2",
    "typescript": "^6.0.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20261029.1",
    "@tailwindcss/typography": "^0.5.20",
    "esbuild": "^0.28.2",
    "pagefind": "^1.4.0",
    "vite": "^7.3.1",
    "wrangler": "^4.78.0"
  }
}
