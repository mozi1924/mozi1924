---
import Icon from "./Icon.astro";
import type { Project } from "./types";

interface Props {
  project: Project;
  highlightPinned?: boolean;
  showPinnedBadge?: boolean;
  hubBaseUrl?: string;
  variant?: "standard" | "showcase";
}

const {
  project,
  highlightPinned = false,
  showPinnedBadge = false,
  hubBaseUrl = "",
  variant = "standard",
} = Astro.props;

const projectSlug = project.slug || project.name.toLowerCase();

// Language dot colors
const languageColors: Record<string, string> = {
  Rust: "bg-[#dea584]",
  Python: "bg-[#3572A5]",
  TypeScript: "bg-[#3178c6]",
  JavaScript: "bg-[#f1e05a]",
  Java: "bg-[#b07219]",
  Astro: "bg-[#ff5a03]",
  HTML: "bg-[#e34c26]",
  C: "bg-[#555555]",
  "C++": "bg-[#f34b7d]",
};

const dotColor = languageColors[project.language || ""] || "bg-gray-400";
const formattedDate = project.pushedAt
  ? new Date(project.pushedAt).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "";

const cleanHubBase = hubBaseUrl.replace(/\/+$/, "");
const projectDocUrl = cleanHubBase
  ? `${cleanHubBase}/projects/${projectSlug}`
  : `/projects/${projectSlug}`;

// For showcase on main site, if project has a dedicated landing/blog page, prefer it as primary
const primaryUrl =
  variant === "showcase" && project.homepage && project.homepage.startsWith("https://mozi1924.com")
    ? project.homepage.replace("https://mozi1924.com", "")
    : projectDocUrl;

const isExternalDoc = projectDocUrl.startsWith("http://") || projectDocUrl.startsWith("https://");
const isExternalPrimary = primaryUrl.startsWith("http://") || primaryUrl.startsWith("https://");
const hasImage = Boolean(project.image);

const ctaText =
  variant === "showcase"
    ? project.homepage && project.homepage.includes("/blogs/")
      ? "Read Article"
      : project.homepage && project.homepage.includes("/mozi-rig")
      ? "Explore Rig"
      : "Explore Project"
    : "Explore Project";
---

<article
  class={`project-card group relative flex bg-[#1a1a1a] rounded-xl md:rounded-2xl overflow-hidden border border-white/5 hover:border-blue-500/30 transition-all duration-300 shadow-sm hover:-translate-y-2 hover:shadow-2xl h-full ${
    hasImage && variant === "showcase"
      ? "flex-row md:flex-col p-4 md:p-0"
      : hasImage
      ? "flex-col p-0"
      : "flex-col justify-between p-5 sm:p-6"
  }`}
  data-name={project.name.toLowerCase()}
  data-description={(project.description || "").toLowerCase()}
  data-language={(project.language || "other").toLowerCase()}
  data-topics={(project.topics || []).join(" ").toLowerCase()}
  data-stars={project.stars}
  data-updated={project.pushedAt || ""}
  data-pinned={project.pinned ? "true" : "false"}
  data-pinned-order={project.pinnedOrder ?? 999}
>
  {/* Desktop Image Region (16:9 Aspect Video) */}
  {hasImage && (
    <div
      class={`relative overflow-hidden bg-[#222] flex-shrink-0 ${
        variant === "showcase" ? "hidden md:block w-full aspect-video" : "w-full aspect-video"
      }`}
    >
      <img
        src={project.image}
        alt={project.name}
        class="w-full h-full object-cover transition-transform duration-500 ease-out group-hover:scale-105"
        loading="lazy"
        decoding="async"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-[#1a1a1a] via-[#1a1a1a]/20 to-transparent opacity-80 pointer-events-none" />

      {/* Floating Badges */}
      <div class="absolute top-3 left-3 flex items-center gap-2 z-10 pointer-events-none">
        {(project.pinned || showPinnedBadge) && (
          <div class="flex items-center gap-1.5 text-[10px] md:text-xs font-mono font-bold uppercase tracking-wider text-blue-400 bg-black/75 backdrop-blur-md px-2.5 py-1 rounded-lg border border-blue-500/30 shadow-md">
            <span>Featured</span>
          </div>
        )}
      </div>

      <div class="absolute top-3 right-3 flex items-center gap-1.5 text-[10px] md:text-xs font-mono text-gray-200 bg-black/75 backdrop-blur-md px-2.5 py-1 rounded-lg border border-white/10 z-10 pointer-events-none">
        <span class={`inline-block w-2 h-2 rounded-full ${dotColor}`}></span>
        <span>{project.language || "Other"}</span>
      </div>
    </div>
  )}

  {/* Content Region */}
  <div
    class={`flex-1 flex flex-col justify-start min-w-0 text-left ${
      hasImage && variant === "showcase"
        ? "p-0 md:p-6"
        : hasImage
        ? "p-5 sm:p-6"
        : ""
    }`}
  >
    {/* Top Meta Line: Language (if no image), Stars, Forks, Date */}
    <div class="flex items-center justify-between gap-3 text-xs md:text-sm text-gray-500 mb-2 font-mono">
      <div class="flex items-center gap-3">
        {!hasImage && (
          <div class="flex items-center gap-1.5 text-gray-300">
            <span class={`inline-block w-2 h-2 rounded-full ${dotColor}`}></span>
            <span class="font-medium">{project.language || "Other"}</span>
          </div>
        )}
        <div class="flex items-center gap-1 text-amber-400/90 font-medium">
          <Icon name="star" className="w-3.5 h-3.5 fill-current" />
          <span>{project.stars}</span>
        </div>
        {project.forks > 0 && (
          <div class="flex items-center gap-1 text-gray-400">
            <Icon name="git-fork" className="w-3.5 h-3.5" strokeWidth={2} />
            <span>{project.forks}</span>
          </div>
        )}
      </div>

      {formattedDate && (
        <div class="hidden sm:flex items-center gap-1 text-gray-500">
          <Icon name="calendar" className="w-3 h-3" />
          <span>{formattedDate}</span>
        </div>
      )}
    </div>

    {/* Title */}
    <h3 class="text-base sm:text-lg md:text-xl font-bold text-white mb-2 group-hover:text-blue-400 transition-colors line-clamp-1 md:line-clamp-2 leading-tight md:leading-snug">
      <a
        href={primaryUrl}
        target={isExternalPrimary ? "_blank" : undefined}
        rel={isExternalPrimary ? "noopener noreferrer" : undefined}
        class="card-link focus-visible:outline-none"
      >
        {project.name}
      </a>
    </h3>

    {/* Description */}
    <p class="text-gray-400 text-xs sm:text-sm line-clamp-2 mb-3 leading-relaxed">
      {project.description || "No description provided."}
    </p>

    {/* Topic Tags */}
    {project.topics && project.topics.length > 0 && (
      <div class="hidden sm:flex flex-wrap gap-1.5 mb-4">
        {project.topics.slice(0, 3).map((topic) => (
          <span class="rounded-md border border-white/5 bg-white/5 px-2 py-0.5 text-[11px] font-mono text-gray-400">
            #{topic}
          </span>
        ))}
        {project.topics.length > 3 && (
          <span class="text-[11px] font-mono text-gray-500 self-center px-1">
            +{project.topics.length - 3}
          </span>
        )}
      </div>
    )}

    {/* Bottom Actions Row */}
    <div class="flex items-center justify-between text-xs sm:text-sm font-bold text-blue-400 mt-auto pt-2">
      <span class="flex items-center group-hover:translate-x-1 transition-transform">
        <span>{ctaText}</span>
        <Icon name="arrow-right" className="w-3.5 h-3.5 ml-1" />
      </span>

      <div class="flex items-center gap-2">
        {projectDocUrl !== primaryUrl && (
          <a
            href={projectDocUrl}
            target={isExternalDoc ? "_blank" : undefined}
            rel={isExternalDoc ? "noopener noreferrer" : undefined}
            class="text-xs font-mono text-gray-400 hover:text-white px-2 py-1 rounded bg-white/5 hover:bg-white/10 transition-colors"
            title="View Documentation"
          >
            Docs
          </a>
        )}
        <a
          href={project.repoUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-400 hover:text-white p-1 rounded-lg hover:bg-white/10 transition-colors"
          title="View on GitHub"
          aria-label={`View ${project.name} on GitHub`}
        >
          <Icon name="github" className="w-4 h-4" strokeWidth={2} />
        </a>
      </div>
    </div>
  </div>

  {/* Mobile Image (Right Side Thumbnail for Showcase variant) */}
  {hasImage && variant === "showcase" && (
    <div class="md:hidden w-24 h-24 sm:w-28 sm:h-28 flex-shrink-0 rounded-xl overflow-hidden border border-white/10 ml-3.5 self-center relative bg-[#222]">
      <img
        src={project.image}
        alt={project.name}
        class="w-full h-full object-cover"
        loading="lazy"
        decoding="async"
      />
      {(project.pinned || showPinnedBadge) && (
        <div class="absolute top-1 left-1 bg-blue-500/80 rounded px-1 py-0.5 text-[8px] text-white font-bold">
          Featured
        </div>
      )}
    </div>
  )}
</article>

<style>
  .project-card:has(a.card-link) {
    position: relative;
  }
  .project-card a.card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .project-card a:not(.card-link),
  .project-card button {
    position: relative;
    z-index: 2;
  }
</style>
