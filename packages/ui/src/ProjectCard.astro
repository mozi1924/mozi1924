---
import Icon from "./Icon.astro";
import type { Project } from "./types";

interface Props {
  project: Project;
  highlightPinned?: boolean;
  showPinnedBadge?: boolean;
  hubBaseUrl?: string;
  variant?: "standard" | "showcase";
}

const {
  project,
  highlightPinned = false,
  showPinnedBadge = false,
  hubBaseUrl = "",
  variant = "standard",
} = Astro.props;

const projectSlug = project.slug || project.name.toLowerCase();

// Language dot colors
const languageColors: Record<string, string> = {
  Rust: "bg-[#dea584]",
  Python: "bg-[#3572A5]",
  TypeScript: "bg-[#3178c6]",
  JavaScript: "bg-[#f1e05a]",
  Java: "bg-[#b07219]",
  Astro: "bg-[#ff5a03]",
  HTML: "bg-[#e34c26]",
  C: "bg-[#555555]",
  "C++": "bg-[#f34b7d]",
  Go: "bg-[#00ADD8]",
  Shell: "bg-[#89e051]",
};

const dotColor = languageColors[project.language || ""] || "bg-gray-400";

const formattedDate = project.pushedAt
  ? new Date(project.pushedAt).toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
    })
  : "";

const cleanHubBase = hubBaseUrl.replace(/\/+$/, "");
const projectDocUrl = cleanHubBase
  ? `${cleanHubBase}/projects/${projectSlug}`
  : `/projects/${projectSlug}`;

// For showcase on main site, if project has a dedicated landing/blog page on mozi1924.com, prefer it as primary
const primaryUrl =
  variant === "showcase" && project.homepage && project.homepage.startsWith("https://mozi1924.com")
    ? project.homepage.replace("https://mozi1924.com", "")
    : projectDocUrl;

const isExternalDoc = projectDocUrl.startsWith("http://") || projectDocUrl.startsWith("https://");
const isExternalPrimary = primaryUrl.startsWith("http://") || primaryUrl.startsWith("https://");

const ctaText =
  variant === "showcase"
    ? project.homepage && project.homepage.includes("/blogs/")
      ? "Read Article"
      : project.homepage && project.homepage.includes("/mozi-rig")
      ? "Explore Rig"
      : "Explore Project"
    : "Explore Project";
---

<article
  class="project-card group relative flex flex-col justify-between h-full bg-[#1a1a1a] rounded-2xl border border-white/5 hover:border-blue-500/30 p-5 sm:p-6 transition-all duration-300 shadow-sm hover:-translate-y-1.5 hover:shadow-xl"
  data-name={project.name.toLowerCase()}
  data-description={(project.description || "").toLowerCase()}
  data-language={(project.language || "other").toLowerCase()}
  data-topics={(project.topics || []).join(" ").toLowerCase()}
  data-stars={project.stars}
  data-updated={project.pushedAt || ""}
  data-pinned={project.pinned ? "true" : "false"}
  data-pinned-order={project.pinnedOrder ?? 999}
>
  <!-- Top & Body Content: flex-1 ensures bottom action row is always pushed to the card bottom -->
  <div class="flex-1 flex flex-col min-w-0">
    <!-- Header Row: Badges on left, Language on right -->
    <div class="flex items-center justify-between gap-3 mb-3 text-xs font-mono">
      <div class="flex items-center gap-2 flex-wrap">
        {(project.pinned || showPinnedBadge) && (
          <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md bg-blue-500/10 text-blue-400 border border-blue-500/20 font-semibold text-[11px]">
            Featured
          </span>
        )}
        {project.archived && (
          <span class="inline-flex items-center px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-400 border border-amber-500/20 text-[10px] uppercase font-bold">
            Archived
          </span>
        )}
      </div>

      <!-- Language Pill -->
      <div class="flex items-center gap-1.5 text-gray-300 shrink-0">
        <span class={`inline-block w-2 h-2 rounded-full ${dotColor}`}></span>
        <span>{project.language || "Other"}</span>
      </div>
    </div>

    <!-- Title -->
    <h3 class="text-lg sm:text-xl font-bold text-white mb-2 group-hover:text-blue-400 transition-colors line-clamp-1 leading-snug">
      <a
        href={primaryUrl}
        target={isExternalPrimary ? "_blank" : undefined}
        rel={isExternalPrimary ? "noopener noreferrer" : undefined}
        class="card-link focus-visible:outline-none"
      >
        {project.name}
      </a>
    </h3>

    <!-- Description -->
    <p class="text-gray-400 text-xs sm:text-sm line-clamp-2 leading-relaxed mb-4">
      {project.description || "No description provided."}
    </p>

    <!-- Meta Row: Stars, Forks, Date, License -->
    <div class="flex flex-wrap items-center gap-3 text-xs font-mono text-gray-500 mb-4">
      <div class="flex items-center gap-1 text-amber-400/90 font-medium">
        <Icon name="star" className="w-3.5 h-3.5 fill-current" />
        <span>{project.stars}</span>
      </div>
      {project.forks > 0 && (
        <div class="flex items-center gap-1 text-gray-400">
          <Icon name="git-fork" className="w-3.5 h-3.5" strokeWidth={2} />
          <span>{project.forks}</span>
        </div>
      )}
      {formattedDate && (
        <div class="flex items-center gap-1 text-gray-500">
          <Icon name="calendar" className="w-3 h-3" />
          <span>{formattedDate}</span>
        </div>
      )}
      {project.license && (
        <span class="text-gray-500 hidden sm:inline">
          {project.license}
        </span>
      )}
    </div>

    <!-- Topic Tags -->
    {project.topics && project.topics.length > 0 && (
      <div class="flex flex-wrap gap-1.5 mb-4">
        {project.topics.slice(0, 4).map((topic) => (
          <span class="rounded-md border border-white/5 bg-white/5 px-2 py-0.5 text-[11px] font-mono text-gray-400">
            #{topic}
          </span>
        ))}
        {project.topics.length > 4 && (
          <span class="text-[11px] font-mono text-gray-500 self-center px-1">
            +{project.topics.length - 4}
          </span>
        )}
      </div>
    )}
  </div>

  <!-- Bottom Actions Row: Stays strictly pinned to the bottom across all cards in the grid row -->
  <div class="mt-4 pt-2 flex items-center justify-between text-xs sm:text-sm font-bold text-blue-400">
    <span class="flex items-center group-hover:translate-x-1 transition-transform">
      <span>{ctaText}</span>
      <Icon name="arrow-right" className="w-3.5 h-3.5 ml-1" />
    </span>

    <div class="flex items-center gap-2">
      {projectDocUrl !== primaryUrl && (
        <a
          href={projectDocUrl}
          target={isExternalDoc ? "_blank" : undefined}
          rel={isExternalDoc ? "noopener noreferrer" : undefined}
          class="text-xs font-mono text-gray-300 hover:text-white px-2 py-1 rounded-md bg-white/5 hover:bg-white/10 border border-white/5 transition-colors"
          title="View Documentation"
        >
          Docs
        </a>
      )}
      <a
        href={project.repoUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="text-gray-400 hover:text-white p-1.5 rounded-lg hover:bg-white/10 transition-colors"
        title="View on GitHub"
        aria-label={`View ${project.name} on GitHub`}
      >
        <Icon name="github" className="w-4 h-4" strokeWidth={2} />
      </a>
      {project.homepage && !project.homepage.startsWith("https://mozi1924.com") && project.homepage !== project.repoUrl && (
        <a
          href={project.homepage}
          target="_blank"
          rel="noopener noreferrer"
          class="text-gray-400 hover:text-white p-1.5 rounded-lg hover:bg-white/10 transition-colors"
          title="Visit Homepage"
          aria-label={`Visit ${project.name} homepage`}
        >
          <Icon name="external" className="w-4 h-4" />
        </a>
      )}
    </div>
  </div>
</article>

<style>
  .project-card:has(a.card-link) {
    position: relative;
  }
  .project-card a.card-link::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .project-card a:not(.card-link),
  .project-card button {
    position: relative;
    z-index: 2;
  }
</style>
