---
import { ClientRouter } from "astro:transitions";
import Analytics from "./Analytics.astro";
import { MOZI_IDENTITY } from "./siteConfig";

export interface Props {
  title: string;
  description?: string;
  canonicalURL?: URL | string;
  image?: string | URL;
  type?: "website" | "article" | "profile" | "blog" | "software";
  ogLocale?: string;
  keywords?: string;
  pubDate?: string | Date;
  modDate?: string | Date;
  authorUrl?: string;
  favicon?: string;
  alternateIcon?: string;
  robots?: string;
}

const {
  title,
  description = "Mozi Arasaka's ecosystem, projects, and creative tools.",
  canonicalURL,
  image = "/avatar.webp",
  type = "website",
  ogLocale = "en_US",
  keywords = "mozi1924, Mozi Arasaka, Blender, Rust, Minecraft, DCC, AI, Open Source",
  pubDate,
  modDate,
  authorUrl = `${MOZI_IDENTITY.primaryUrl}/about`,
  favicon = "/favicon.svg",
  alternateIcon = "/favicon.ico",
  robots = "index, follow, max-image-preview:large",
} = Astro.props;

// Compute absolute image URL
const ogImageUrl = typeof image === "string" && !image.startsWith("http")
  ? new URL(image, Astro.site || MOZI_IDENTITY.primaryUrl).href
  : typeof image === "string"
  ? image
  : image.href;

// Standardize Canonical URL
const resolvedCanonical = canonicalURL
  ? typeof canonicalURL === "string"
    ? canonicalURL
    : canonicalURL.href
  : new URL(Astro.url.pathname, Astro.site || MOZI_IDENTITY.primaryUrl).href;

const isArticle = type === "article" || type === "blog";
---

<!-- Core Meta -->
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />
<meta name="color-scheme" content="dark" />
<meta name="robots" content={robots} />

<!-- Canonical & Title -->
<link rel="canonical" href={resolvedCanonical} />
<title>{title}</title>
<meta name="description" content={description} />
{keywords && <meta name="keywords" content={keywords} />}

<!-- Icons & Sitemap -->
<link rel="icon" type="image/svg+xml" href={favicon} />
{alternateIcon && <link rel="alternate icon" href={alternateIcon} />}
<link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />

<!-- Open Graph -->
<meta property="og:type" content={isArticle ? "article" : "website"} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:url" content={resolvedCanonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:logo" content={new URL(favicon, Astro.site || MOZI_IDENTITY.primaryUrl).href} />

{
  isArticle && (
    <>
      {pubDate && (
        <meta
          property="article:published_time"
          content={new Date(pubDate).toISOString()}
        />
      )}
      {modDate && (
        <meta
          property="article:modified_time"
          content={new Date(modDate).toISOString()}
        />
      )}
      {authorUrl && <meta property="article:author" content={authorUrl} />}
    </>
  )
}

<!-- Twitter Cards -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={resolvedCanonical} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImageUrl} />

<!-- Shared Analytics & Astro ClientRouter (ViewTransitions) -->
<Analytics />
<ClientRouter />

<!-- Site-specific injection slot (e.g. AdSense, RSS, Translations, StructuredData) -->
<slot />
