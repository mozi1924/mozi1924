---
import Icon from "./Icon.astro";

export interface Props {
  title?: string;
  subtitle?: string;
  message?: string;
  homeUrl?: string;
  homeText?: string;
  secondaryUrl?: string;
  secondaryText?: string;
  secondaryIcon?: "external" | "arrow-right" | "github";
}

const {
  title = "404",
  subtitle = "Page Not Found",
  message = "Oops! The page you're looking for seems to have wandered off into the void.",
  homeUrl = "/",
  homeText = "Back Home",
  secondaryUrl,
  secondaryText,
  secondaryIcon = "external",
} = Astro.props;
---

<div
  class="relative min-h-[75vh] flex flex-col items-center justify-center text-center px-6 overflow-hidden py-16"
>
  <!-- Background Glow & Particle Elements -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none -z-10">
    <div
      class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[500px] bg-blue-500/15 blur-[120px] rounded-full animate-pulse"
    >
    </div>
    <div
      class="absolute top-1/4 left-1/4 w-32 h-32 bg-purple-500/10 blur-[60px] rounded-full"
    >
    </div>
    <div
      class="absolute bottom-1/4 right-1/4 w-40 h-40 bg-pink-500/10 blur-[60px] rounded-full"
    >
    </div>
  </div>

  <div class="relative z-10 space-y-6 max-w-xl mx-auto">
    <!-- 404 Hero Heading -->
    <h1
      class="text-8xl sm:text-9xl font-black tracking-tight text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-indigo-400 to-purple-500 select-none"
    >
      {title}
    </h1>

    <!-- Subtitle & Message -->
    <div class="space-y-3">
      <h2 class="text-2xl sm:text-3xl font-bold text-white tracking-tight">
        {subtitle}
      </h2>
      <p class="text-gray-400 text-sm sm:text-base leading-relaxed max-w-md mx-auto">
        {message}
      </p>
    </div>

    <!-- Action Buttons -->
    <div class="pt-6 flex flex-wrap items-center justify-center gap-3">
      <a
        href={homeUrl}
        class="inline-flex items-center gap-2 px-7 py-3 bg-white text-black font-semibold text-sm rounded-xl hover:bg-gray-200 transition-all shadow-lg hover:shadow-white/10 active:scale-95"
      >
        <Icon name="home" className="w-4 h-4" strokeWidth={2.2} />
        <span>{homeText}</span>
      </a>

      {secondaryUrl && secondaryText && (
        <a
          href={secondaryUrl}
          class="inline-flex items-center gap-2 px-6 py-3 rounded-xl border border-white/10 bg-white/[0.04] text-sm font-medium text-gray-200 hover:bg-white/[0.08] hover:text-white transition-all active:scale-95"
        >
          <span>{secondaryText}</span>
          <Icon name={secondaryIcon} className="w-4 h-4 text-gray-400" />
        </a>
      )}
    </div>

    <slot />
  </div>
</div>
