{
  "name": "mozi1924-monorepo",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:web",
    "dev:web": "pnpm --filter @mozi/web dev",
    "dev:hub": "pnpm --filter @mozi/hub dev",
    "dev:all": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm build:web && pnpm build:hub",
    "build:web": "pnpm --filter @mozi/web build",
    "build:hub": "pnpm --filter @mozi/hub build",
    "check": "pnpm check:all",
    "check:web": "pnpm --filter @mozi/web check",
    "check:hub": "pnpm --filter @mozi/hub check",
    "check:all": "pnpm check:web && pnpm check:hub",
    "sync:hub": "pnpm --filter @mozi/hub sync"
  }
}
